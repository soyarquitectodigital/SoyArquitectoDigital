---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import SpecialtyIcon from '../components/icons/SpecialtyIcon.astro';
import { specialties } from '../data/specialties';
import { services } from '../data/services';
import { site, bookingUrl, whatsapp, whatsappDefault } from '../config';

const path = '/servicios';
const title = 'Servicios: integraciones, automatización, apps a medida y más';
const description =
  'Servicios de arquitectura digital para PYMEs y startups: integración de CRM y ERP, automatización con n8n e IA, aplicaciones a medida, webs y Kit Digital, datos, cloud y seguridad.';

const auditUrl = bookingUrl('Hola Oswaldo, vi los servicios y quiero la auditoría de 5 días.');

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL(path, site.url).href },
  ],
};

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Especialidades de Soy Arquitecto Digital',
  itemListElement: specialties.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    description: item.tagline,
    url: new URL(`/servicios/${item.slug}`, site.url).href,
  })),
};
---

<BaseLayout title={title} description={description} schema={[servicesSchema, breadcrumbs]}>
  <section class="tint-brand bg-paper pt-28 pb-16 sm:pt-32 sm:pb-20">
    <div class="container-page">
      <nav aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">Servicios</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16" data-reveal>
        <div>
          <Eyebrow number="—">Servicios</Eyebrow>
          <h1 class="mt-6 font-heading display-xl font-semibold text-text">
            Todo tu ecosistema, <span class="text-gradient-brand">con un responsable</span>
          </h1>
        </div>
        <div>
          <p class="max-w-xl leading-relaxed text-copy">
            Tres formas de trabajar según el momento de tu negocio, y siete especialidades concretas
            para cuando ya sabes qué te hace falta. En cualquier caso: un solo interlocutor y
            entregas visibles cada semana.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <Button href={auditUrl} external>Agendar diagnóstico</Button>
            <Button href={whatsappDefault} variant="ghost-light" external>Hablemos por WhatsApp</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Tres formas de trabajar */}
  <section class="section-pad border-y border-line bg-surface scroll-mt-24" id="formas">
    <div class="container-page">
      <Eyebrow number="01">Formas de trabajar</Eyebrow>
      <div class="mt-8 grid gap-6 lg:grid-cols-3 lg:gap-8">
        {
          services.map((service, index) => (
            <article
              class="card hairline spotlight relative flex flex-col p-6 transition duration-300 hover:border-line-strong sm:p-7"
              data-reveal
              data-glow
              style={`--delay:${index * 80}ms`}
            >
              <div class="flex items-center justify-between gap-4">
                <span class="font-mono text-[11px] tracking-[0.22em] text-dim">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="pill border-line bg-paper text-[11px] text-copy">{service.meta}</span>
              </div>
              <h2 class="font-heading mt-5 text-2xl leading-tight font-semibold text-text">
                {service.name}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-copy">{service.description}</p>
              <div class="mt-6 flex items-center justify-between gap-4 border-t border-line pt-5">
                <span>
                  <span class="block font-mono text-[10px] tracking-[0.18em] text-dim uppercase">
                    {service.priceLabel}
                  </span>
                  <span class="text-sm font-semibold text-text">{service.price}</span>
                </span>
                <a
                  href={service.booking
                    ? bookingUrl(`Hola Oswaldo, quiero reservar la ${service.name}.`)
                    : whatsapp(`Hola Oswaldo, me interesa el servicio de ${service.name}. ¿Lo vemos?`)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold whitespace-nowrap text-brand-ink transition duration-300 hover:border-brand/40"
                >
                  {service.booking ? 'Reservar' : 'Consultar'}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* Especialidades */}
  <section class="section-pad tint-brand bg-paper scroll-mt-24" id="especialidades">
    <div class="container-page">
      <Eyebrow number="02">Especialidades</Eyebrow>
      <div class="mt-8 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-end lg:gap-16" data-reveal>
        <h2 class="font-heading display-lg font-semibold text-text">
          ¿Ya sabes qué necesitas? <span class="text-gradient-brand">Entra por aquí</span>
        </h2>
        <p class="max-w-xl leading-relaxed text-copy">
          Cada especialidad tiene su propia página: qué incluye, para quién es y una conversación
          directa por WhatsApp para contarla con tus palabras.
        </p>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {
          specialties.map((item, index) => (
            <a
              href={`/servicios/${item.slug}`}
              class="card hairline spotlight relative flex flex-col p-5 transition duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-lift sm:p-6"
              data-reveal
              data-glow
              style={`--delay:${(index % 4) * 70}ms`}
            >
              <span class="grid size-11 place-items-center rounded-2xl border border-line bg-paper text-brand-ink">
                <SpecialtyIcon icon={item.icon} class="size-5" />
              </span>
              <h3 class="font-heading mt-5 text-lg leading-snug font-semibold text-text">
                {item.name}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-copy">{item.tagline}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-ink">
                Ver servicio
                <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
                  <path
                    d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          ))
        }

        <a
          href={whatsappDefault}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-positive hairline spotlight relative flex flex-col border-brand/25 p-5 transition duration-300 hover:-translate-y-1 hover:shadow-lift sm:p-6"
          data-reveal
          data-glow
        >
          <span class="grid size-11 place-items-center rounded-2xl border border-brand/30 bg-surface text-brand-ink">
            <SpecialtyIcon icon="globe" class="size-5" />
          </span>
          <h3 class="font-heading mt-5 text-lg leading-snug font-semibold text-text">
            ¿Otra cosa distinta?
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-copy">
            Si tu necesidad no encaja en ninguna, cuéntamela: si no soy la persona adecuada, te
            oriento igual.
          </p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-ink">
            Contarlo por WhatsApp
            <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
              <path
                d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  {/* CTA de cierre */}
  <section class="bg-paper pb-20 sm:pb-24">
    <div class="container-page">
      <div class="gradient-close grain vignette animate-pan relative overflow-hidden rounded-card" data-reveal>
        <div class="relative px-6 py-12 sm:px-10 sm:py-14 lg:px-14">
          <div class="max-w-2xl">
            <Eyebrow number="—" tone="dark">Siguiente paso</Eyebrow>
            <h2 class="mt-5 font-heading display-lg font-semibold text-white">
              ¿No sabes todavía cuál te toca?
            </h2>
            <p class="mt-4 leading-relaxed text-copy-dark">
              Agendamos una llamada de diagnóstico sin coste y salimos con una idea clara de por
              dónde empezar, contrates o no después.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3">
              <Button href={auditUrl} external>Agendar diagnóstico gratuito</Button>
              <Button href={whatsappDefault} variant="ghost-dark" external>
                Prefiero escribir por WhatsApp
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
