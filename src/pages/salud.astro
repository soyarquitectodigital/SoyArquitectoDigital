---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CtaTracking from '../components/CtaTracking.astro';
import Eyebrow from '../components/Eyebrow.astro';
import WaButton from '../components/WaButton.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Wordmark from '../components/Wordmark.astro';
import { site, whatsapp, whatsappNumber } from '../config';
import {
  publico,
  confianza,
  problemas,
  cierreProblema,
  pilares,
  diagnosticoPuntos,
  pasos,
  faqs,
  oferta,
  sinPrueba,
  sobreMi,
  testimonio,
  caso,
} from '../data/salud';

const path = '/salud';
const title = 'Páginas web y automatización para profesionales de la salud en Venezuela';
const description =
  'Arquitectura digital para médicos, odontólogos y clínicas en Venezuela. Experiencia real en salud, diagnóstico gratuito y 3 plazas fundadoras.';

// Un mensaje distinto por CTA para saber qué sección convierte. Todos llegan al
// mismo WhatsApp: la diferencia es el texto, que se ve en el primer mensaje.
const waDiagnostico = whatsapp(
  'Hola, vi la página de arquitectura digital para profesionales de la salud y quiero mi diagnóstico gratuito de 15 minutos.',
);
const waDiagnosticoSeccion = whatsapp(
  'Hola, quiero agendar mi diagnóstico gratuito de 15 minutos. Te cuento mi especialidad y en qué ciudad estoy.',
);
const waPlazas = whatsapp(
  'Hola, quiero una de las 3 plazas fundadoras para mi consulta. Te cuento mi especialidad y en qué ciudad estoy.',
);
const waEmpezar = whatsapp(
  'Hola, quiero empezar. Te cuento mi especialidad y en qué ciudad estoy.',
);
const waFinal = whatsapp(
  'Hola, quiero mi diagnóstico gratuito para mi consulta. Te cuento mi especialidad y en qué ciudad estoy.',
);

const telDisplay = `+${whatsappNumber.slice(0, 2)} ${whatsappNumber.slice(2, 5)} ${whatsappNumber.slice(5, 8)} ${whatsappNumber.slice(8)}`;

const checkPath = 'm5 10.5 3.2 3.2L15 6.5';
const warnPath = 'M10 3.6 17.2 16.4H2.8L10 3.6ZM10 8.2v3.2M10 13.9h.01';

const pilarIcons: Record<string, string> = {
  presencia: 'M12 3.4a8.6 8.6 0 1 0 0 17.2 8.6 8.6 0 0 0 0-17.2ZM3.4 12h17.2M12 3.4c2.3 2.4 3.5 5.4 3.5 8.6S14.3 18.2 12 20.6c-2.3-2.4-3.5-5.4-3.5-8.6S9.7 5.8 12 3.4Z',
  operacion: 'M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2ZM12 2.8v2.2M12 19v2.2M4.8 12H2.6M21.4 12h-2.2M6.9 6.9 5.3 5.3M18.7 18.7l-1.6-1.6M17.1 6.9l1.6-1.6M5.3 18.7l1.6-1.6',
  crecimiento: 'M3.6 17.6l5.2-6.6 4 3 7.6-9.4M15.2 4.6h5.2v5.2',
};

// Titular troceado para la animación palabra a palabra, igual que el hero del sitio.
const headline = [
  { text: 'Tu' },
  { text: 'presencia', accent: true },
  { text: 'digital', accent: true },
  { text: 'merece' },
  { text: 'ser' },
  { text: 'tan' },
  { text: 'profesional' },
  { text: 'como' },
  { text: 'la' },
  { text: 'atención' },
  { text: 'que' },
  { text: 'das.' },
];

const hayPrueba = Boolean(testimonio || caso);
const year = new Date().getFullYear();

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Arquitectura digital para profesionales de la salud',
  description:
    'Presencia digital, automatización de agenda y crecimiento para médicos, odontólogos, psicólogos, nutricionistas, clínicas y consultorios en Venezuela. Con experiencia real en el sector salud. Incluye diagnóstico gratuito de 15 minutos.',
  serviceType: 'Arquitectura digital y automatización para el sector salud',
  provider: {
    '@type': 'Person',
    name: site.person,
    jobTitle: site.role,
    url: site.url,
    email: `mailto:${site.email}`,
  },
  areaServed: { '@type': 'Country', name: 'Venezuela' },
  audience: {
    '@type': 'Audience',
    audienceType: 'Profesionales de la salud, clínicas y consultorios',
  },
  availableLanguage: 'es',
  url: new URL(path, site.url).href,
  offers: {
    '@type': 'Offer',
    name: 'Diagnóstico gratuito de 15 minutos',
    price: '0',
    priceCurrency: 'USD',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: faq.respuesta },
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Salud', item: new URL(path, site.url).href },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image="/og-salud.png"
  imageAlt="Soy Arquitecto Digital — presencia digital para profesionales de la salud"
  schema={[serviceSchema, faqSchema, breadcrumbs]}
  navOnDark
  bare
>
  <CtaTracking />

  {/*
    Misma barra flotante que el sitio principal: reutiliza #site-nav y
    .nav-shell, así que hereda el fondo translúcido sobre el hero oscuro y se
    vuelve sólida al bajar, sin CSS nuevo.
  */}
  <header slot="above" id="site-nav" class="fixed inset-x-0 top-0 z-50">
    <div class="container-page pt-3 sm:pt-4">
      <div
        class="nav-shell flex items-center justify-between gap-4 rounded-full border px-4 py-2.5 sm:px-5"
      >
        <a href="/" class="nav-logo shrink-0" aria-label="Soy Arquitecto Digital — ir al inicio">
          <Wordmark />
        </a>

        <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
          <a
            href="#diagnostico"
            data-cta="nav_diagnostico"
            class="nav-cta-ghost hidden h-10 items-center rounded-full border px-4 text-sm font-semibold whitespace-nowrap transition sm:inline-flex"
          >
            Diagnóstico gratis
          </a>
          <a
            href={waDiagnostico}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="nav_whatsapp"
            class="inline-flex h-10 items-center gap-2 rounded-full bg-wa px-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-wa-strong sm:px-4"
          >
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413"
              ></path>
            </svg>
            <span class="hidden sm:inline">Hablemos</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  {/* BLOQUE 1 · Hero oscuro, con el mismo tratamiento del sitio principal */}
  <section id="inicio" class="grain vignette relative overflow-hidden bg-ink">
    <div class="hero-aurora" aria-hidden="true">
      <span class="aurora aurora-1"></span>
      <span class="aurora aurora-2"></span>
      <span class="aurora aurora-3"></span>
      <span class="aurora aurora-4"></span>
    </div>
    <div class="hero-sweep" aria-hidden="true"></div>
    <div class="bg-mesh animate-mesh absolute inset-0" aria-hidden="true"></div>
    <div
      class="bg-grid-dark grid-drift absolute inset-0 opacity-35 [mask-image:radial-gradient(85%_65%_at_50%_18%,black,transparent_78%)]"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-b from-transparent to-ink"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative pt-32 pb-14 sm:pt-36 lg:pt-44 lg:pb-20">
      <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr] xl:gap-20">
        <div class="min-w-0">
          <p class="pill animate-float text-white">
            <span class="relative inline-flex size-2 text-brand-light">
              <span class="pulse-dot absolute inset-0 rounded-full bg-brand-light"></span>
              <span class="relative inline-block size-2 rounded-full bg-brand-light"></span>
            </span>
            Arquitectura digital para el sector salud
          </p>

          <h1 class="mt-6 max-w-2xl font-heading display-xl font-semibold text-white">
            {
              headline.map((token, index) => (
                <>
                  <span class="word-mask">
                    <span
                      class:list={['word-in', token.accent && 'text-gradient-light']}
                      style={`--d:${120 + index * 70}ms`}
                    >
                      {token.text}
                    </span>
                  </span>{' '}
                </>
              ))
            }
          </h1>

          <p class="mt-7 max-w-xl text-lg leading-relaxed text-copy-dark">
            Ayudo a profesionales de la salud en Venezuela a captar más pacientes, recuperar tiempo
            perdido en gestión y construir una marca que genere confianza.
          </p>

          <p class="mt-3 max-w-xl text-sm leading-relaxed text-dim-dark">
            {publico}. Con experiencia real en el sector: dirigí el marketing digital de una clínica
            dental en Venezuela.
          </p>

          <div class="mt-9">
            <WaButton href={waDiagnostico} cta="hero_diagnostico">
              Quiero mi diagnóstico gratuito de 15 minutos
            </WaButton>
          </div>

          <p class="mt-4 max-w-md text-sm leading-relaxed text-dim-dark">
            Sin compromiso. Te llevas un checklist de 5 puntos críticos de tu presencia digital, lo
            uses conmigo o no.
          </p>
        </div>

        <div
          class="card-dark spotlight spotlight-dark hairline hairline-dark relative min-w-0 p-6 sm:p-7"
          data-reveal
          data-glow
        >
          <div class="flex items-center justify-between gap-4">
            <p class="font-mono text-[11px] tracking-[0.22em] text-dim-dark uppercase">
              {oferta.etiqueta}
            </p>
            <span class="pill text-[11px] text-brand-light whitespace-nowrap">Solo 3</span>
          </div>
          <p class="font-heading mt-4 text-2xl leading-tight text-white sm:text-3xl">
            {oferta.titulo}
          </p>
          <p class="mt-3 text-sm leading-relaxed text-copy-dark">{oferta.teaser}</p>
          <div class="mt-6">
            <WaButton href={waPlazas} size="md" cta="hero_plaza">{oferta.cta}</WaButton>
          </div>
          <a
            href="#plazas"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-light transition hover:text-white"
          >
            Ver qué incluye y qué pido a cambio
            <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
              <path
                d="M10 4.2v11.6M4.2 10l5.8 5.8L15.8 10"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* BLOQUE 2 · Barra de confianza, dentro del mismo bloque oscuro */}
    <div class="relative border-t border-line-dark">
      <div class="container-page py-6 sm:py-7">
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {
            confianza.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-snug text-copy-dark">
                <svg
                  viewBox="0 0 20 20"
                  class="mt-0.5 size-4 shrink-0 text-brand-light"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d={checkPath}
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* BLOQUE 3 · El problema */}
  <section id="problema" class="section-pad tint-brand scroll-mt-24 bg-paper">
    <div class="container-page">
      <Eyebrow number="01">El problema</Eyebrow>

      <div class="mt-8 grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 xl:gap-24">
        <div data-reveal>
          <h2 class="font-heading display-lg font-semibold text-text">
            ¿Te <span class="text-gradient-brand">suena familiar</span>?
          </h2>
          <p class="mt-5 max-w-md leading-relaxed text-copy">
            Ninguna de estas cosas aparece de golpe. Se acumulan en silencio mientras la agenda se
            llena de huecos y el equipo pierde horas en tareas que se pueden automatizar.
          </p>

          <p class="mt-8 font-heading text-xl leading-snug font-semibold text-text sm:text-2xl">
            {cierreProblema.antes}<span class="text-brand-ink">{cierreProblema.destacado}</span>{cierreProblema.despues}
          </p>
        </div>

        <ul class="divide-y divide-line border-y border-line">
          {
            problemas.map((item, index) => (
              <li class="flex gap-4 py-5" data-reveal style={`--delay:${index * 70}ms`}>
                <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-warn/12 text-warn">
                  <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
                    <path
                      d={warnPath}
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="text-[15px] leading-relaxed text-copy sm:text-base">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* BLOQUE 4 · La solución */}
  <section id="solucion" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
    <div class="container-page">
      <Eyebrow number="02">La solución</Eyebrow>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16" data-reveal>
        <h2 class="font-heading display-lg font-semibold text-text">
          No vendo páginas web. Construyo
          <span class="text-gradient-brand">ecosistemas digitales</span> para profesionales de la
          salud.
        </h2>
        <p class="leading-relaxed text-copy lg:pb-1">
          Mi trabajo es ordenar el caos digital de tu práctica en tres capas. Empezamos por lo que
          más te duele y menos te cuesta.
        </p>
      </div>

      <ol class="mt-12 grid gap-5 lg:grid-cols-3 xl:gap-6">
        {
          pilares.map((pilar, index) => (
            <li
              class="card hairline spotlight relative flex flex-col p-6 sm:p-7"
              data-reveal
              data-glow
              style={`--delay:${index * 90}ms`}
            >
              <div class="flex items-center justify-between gap-4">
                <span class="grid size-11 place-items-center rounded-2xl bg-paper text-brand-ink">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
                    <path
                      d={pilarIcons[pilar.icono]}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="font-mono text-[11px] tracking-[0.22em] text-brand-ink">
                  Pilar {index + 1}
                </span>
              </div>
              <h3 class="font-heading mt-6 text-xl leading-snug font-semibold text-text">
                {pilar.titulo}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-copy sm:text-[15px]">{pilar.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* BLOQUE 4 · Quién está detrás: experiencia real en salud y método */}
  <section id="sobre-mi" class="section-pad tint-brand scroll-mt-24 bg-paper">
    <div class="container-page">
      <Eyebrow number="03">{sobreMi.eyebrow}</Eyebrow>

      <div class="mt-8 grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 xl:gap-24">
        <div data-reveal>
          <h2 class="font-heading display-lg font-semibold text-text">{sobreMi.titulo}</h2>
          <p class="mt-5 font-heading text-xl leading-snug font-semibold text-brand-ink sm:text-2xl">
            {sobreMi.destacado}
          </p>
          <p class="mt-6 max-w-md leading-relaxed text-copy">{sobreMi.intro}</p>
          <p class="mt-4 max-w-md leading-relaxed text-copy">{sobreMi.cuerpo}</p>

          <ul class="mt-8 flex flex-wrap gap-2.5">
            {
              sobreMi.principios.map((principio) => (
                <li class="rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-copy">
                  {principio}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card hairline spotlight relative p-6 sm:p-8" data-reveal data-glow>
          <p class="number-tag">Trayectoria</p>
          <ol class="mt-5 divide-y divide-line">
            {
              sobreMi.hitos.map((hito) => (
                <li class="flex items-start gap-3 py-4 first:pt-0 last:pb-0">
                  <svg
                    viewBox="0 0 20 20"
                    class="mt-1 size-4 shrink-0 text-brand-ink"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d={checkPath}
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <span class="text-[15px] leading-relaxed text-copy">{hito}</span>
                </li>
              ))
            }
          </ol>
          <a
            href="#diagnostico"
            data-cta="sobre_diagnostico"
            class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-ink transition hover:text-text"
          >
            Ver qué revisamos en el diagnóstico
            <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
              <path
                d="M10 4.2v11.6M4.2 10l5.8 5.8L15.8 10"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* BLOQUE 5 · El diagnóstico, en bloque oscuro como la sección de enfoque */}
  <section id="diagnostico" class="grain section-pad scroll-mt-24 relative overflow-hidden bg-ink-soft">
    <div
      class="pointer-events-none absolute -top-40 right-[-10%] size-[34rem] rounded-full bg-brand/25 blur-[140px]"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative">
      <Eyebrow number="04" tone="dark">El diagnóstico</Eyebrow>

      <div class="mt-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div data-reveal>
          <h2 class="font-heading display-lg font-semibold text-white">
            ¿Qué pasa en esos <span class="text-gradient-light">15 minutos</span>?
          </h2>
          <p class="mt-5 max-w-md leading-relaxed text-copy-dark">
            No es una llamada de ventas. Es una auditoría express donde revisamos juntos estos cinco
            puntos.
          </p>
          <p class="mt-8 max-w-md leading-relaxed font-semibold text-white">
            Te llevas un checklist de 5 puntos críticos y una idea clara de por dónde empezar. Sin
            compromiso.
          </p>
          <div class="mt-8">
            <WaButton href={waDiagnosticoSeccion} cta="diagnostico_whatsapp">
              Agendar mi diagnóstico gratuito
            </WaButton>
          </div>
        </div>

        <div class="card-dark spotlight spotlight-dark hairline hairline-dark p-6 sm:p-8" data-reveal>
          <ol class="divide-y divide-white/10">
            {
              diagnosticoPuntos.map((item, index) => (
                <li class="flex items-start gap-4 py-4 first:pt-0 last:pb-0">
                  <span class="grid size-7 shrink-0 place-items-center rounded-full bg-white/8 font-mono text-[11px] font-semibold text-brand-light">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="text-[15px] leading-relaxed text-copy-dark">{item}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {/* BLOQUE 6 · Prueba social y oferta de las 3 plazas */}
  <section id="plazas" class="section-pad tint-brand scroll-mt-24 bg-paper">
    <div class="container-page">
      <Eyebrow number="05">Las 3 plazas</Eyebrow>

      {
        hayPrueba && (
          <div class="mt-8 grid gap-6 lg:grid-cols-2 lg:gap-8">
            {testimonio && (
              <figure class="card hairline relative p-6 sm:p-7" data-reveal>
                <blockquote class="font-heading text-lg leading-snug text-text sm:text-xl">
                  «{testimonio.cita}»
                </blockquote>
                <figcaption class="mt-4 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
                  {testimonio.autor} · {testimonio.cargo}
                </figcaption>
              </figure>
            )}

            {caso && (
              <div class="card hairline relative p-6 sm:p-7" data-reveal>
                <p class="number-tag">Análisis reciente</p>
                <h3 class="font-heading mt-3 text-lg font-semibold text-text sm:text-xl">
                  Consultorio de {caso.especialidad} · {caso.ciudad}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-copy">{caso.situacion}</p>
                <p class="mt-3 text-sm leading-relaxed font-semibold text-text">
                  {caso.proyeccion}
                </p>
              </div>
            )}
          </div>
        )
      }

      {
        !hayPrueba && (
          <p class="mt-6 flex max-w-3xl items-start gap-3 rounded-2xl border border-line bg-surface p-5 text-sm leading-relaxed text-copy sm:text-[15px]">
            <svg
              viewBox="0 0 20 20"
              class="mt-0.5 size-4 shrink-0 text-brand-ink"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M10 17.2a7.2 7.2 0 1 0 0-14.4 7.2 7.2 0 0 0 0 14.4ZM10 6.6v3.6M10 13.4h.01"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span>{sinPrueba}</span>
          </p>
        )
      }

      <div
        class="card hairline spotlight relative mt-8 overflow-hidden p-7 sm:p-10 lg:p-12"
        data-reveal
        data-glow
      >
        <div
          class="gradient-secondary pointer-events-none absolute inset-0 opacity-15"
          aria-hidden="true"
        >
        </div>
        <div class="relative grid gap-10 lg:grid-cols-2 lg:gap-16">
          <div>
            <p class="font-mono text-[11px] tracking-[0.22em] text-brand-ink uppercase">
              {oferta.etiqueta}
            </p>
            <h2 class="font-heading mt-3 text-2xl font-semibold text-text sm:text-3xl lg:text-4xl">
              {oferta.titulo}
            </h2>
            <p class="mt-4 leading-relaxed text-copy">{oferta.intro}</p>
          </div>

          <div>
            <h3 class="number-tag">Qué incluye</h3>
            <ul class="mt-4 space-y-3">
              {
                oferta.incluye.map((item) => (
                  <li class="flex items-start gap-3 text-[15px] leading-relaxed text-copy">
                    <svg
                      viewBox="0 0 20 20"
                      class="mt-1 size-4 shrink-0 text-brand-ink"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d={checkPath}
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>

            <h3 class="number-tag mt-8">Qué te pido a cambio</h3>
            <p class="mt-4 leading-relaxed text-copy">{oferta.contrapartida}</p>

            <h3 class="number-tag mt-8">Qué pasa después</h3>
            <p class="mt-4 leading-relaxed text-copy">{oferta.despues}</p>

            <div class="mt-8">
              <WaButton href={waPlazas} cta="plazas_whatsapp">{oferta.cta}</WaButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* BLOQUE 7 · Cómo funciona */}
  <section id="como" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
    <div class="container-page">
      <Eyebrow number="06">Cómo funciona</Eyebrow>

      <div class="mt-8 grid gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16" data-reveal>
        <h2 class="font-heading display-lg font-semibold text-text">
          Así de <span class="text-gradient-brand">simple</span>
        </h2>
        <p class="leading-relaxed text-copy lg:pb-1">
          Tres pasos. Ninguno te quita tiempo de consulta.
        </p>
      </div>

      <ol class="mt-12 grid gap-5 lg:grid-cols-3 xl:gap-6">
        {
          pasos.map((paso, index) => (
            <li
              class="card hairline spotlight relative flex flex-col p-6 sm:p-7"
              data-reveal
              data-glow
              style={`--delay:${index * 90}ms`}
            >
              <div class="flex items-center gap-4">
                <span class="grid size-10 place-items-center rounded-full bg-brand font-heading text-base font-semibold text-on-brand">
                  {index + 1}
                </span>
                <span class="font-mono text-[11px] tracking-[0.22em] text-dim uppercase">
                  Paso {index + 1}
                </span>
              </div>
              <h3 class="font-heading mt-5 text-lg leading-snug font-semibold text-text sm:text-xl">
                {paso.titulo}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-copy sm:text-[15px]">{paso.texto}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10" data-reveal>
        <WaButton href={waEmpezar} cta="como_whatsapp">Empezar por WhatsApp</WaButton>
      </div>
    </div>
  </section>

  {/* BLOQUE 8 · Preguntas frecuentes */}
  <section id="preguntas" class="section-pad tint-brand scroll-mt-24 bg-paper">
    <div class="container-page grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 xl:gap-24">
      <div data-reveal>
        <Eyebrow number="07">Preguntas frecuentes</Eyebrow>
        <h2 class="mt-8 font-heading display-lg font-semibold text-text">
          Dudas frecuentes, respuestas <span class="text-brand-ink">directas</span>
        </h2>
        <p class="mt-5 max-w-md leading-relaxed text-copy">
          Si la tuya no está aquí, escríbeme por WhatsApp y te contesto sin compromiso.
        </p>
      </div>

      <div class="space-y-3" data-reveal>
        {
          faqs.map((faq, index) => (
            <details
              class="card hairline group px-5 py-4 transition-colors open:border-line-strong hover:border-line-strong sm:px-6"
              data-reveal
              style={`--delay:${index * 70}ms`}
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4">
                <h3 class="font-heading text-base leading-snug font-semibold text-text sm:text-lg">
                  {faq.pregunta}
                </h3>
                <span
                  class="grid size-7 shrink-0 place-items-center rounded-full bg-paper text-base leading-none text-copy transition duration-300 group-open:rotate-45 group-open:bg-brand group-open:text-on-brand"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="mt-3 max-w-prose text-sm leading-relaxed text-copy sm:text-[15px]">
                {faq.respuesta}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* BLOQUE 9 · CTA final, con el mismo cierre del sitio principal */}
  <section id="contacto" class="section-pad scroll-mt-24 bg-paper">
    <div class="container-page">
      <div class="gradient-close grain vignette animate-pan relative overflow-hidden rounded-card">
        <div class="bg-grid-dark absolute inset-0 opacity-20" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute -top-40 left-[-10%] size-[38rem] rounded-full bg-brand-light/12 blur-[150px]"
          aria-hidden="true"
        >
        </div>

        <div class="relative px-6 py-14 sm:px-10 sm:py-16 lg:px-14 lg:py-20">
          <Eyebrow number="08" tone="dark">Siguiente paso</Eyebrow>

          <div class="mt-8 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
            <div data-reveal>
              <h2 class="font-heading display-lg font-semibold text-white">
                Tu práctica puede verse y <span class="text-gradient-light">operar mejor</span>.
                Empecemos hoy.
              </h2>
              <p class="mt-5 max-w-xl leading-relaxed text-copy-dark">
                Agenda tu diagnóstico gratuito de 15 minutos. Te llevas un checklist de 5 puntos
                críticos, lo uses conmigo o no.
              </p>
            </div>

            <div class="lg:pl-4" data-reveal>
              <WaButton href={waFinal} cta="final_whatsapp">Quiero mi diagnóstico gratuito</WaButton>
              <p class="mt-5 text-sm text-dim-dark">
                También puedes escribirme directo:
                <a
                  href={waFinal}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-cta="final_telefono"
                  class="font-semibold text-white underline decoration-brand-light/60 underline-offset-4 transition hover:text-brand-light"
                >
                  {telDisplay}
                </a>
                <span class="text-dim-dark">(WhatsApp internacional)</span>
              </p>
              <p class="mt-4 text-sm leading-relaxed text-copy-dark">
                Atiendo en remoto a profesionales y centros de toda Venezuela: la coordinación es por
                WhatsApp y videollamada, sin que tengas que moverte de tu consulta.
              </p>
            </div>
          </div>

          <div class="border-t border-line-dark">
            <ContactForm
              channel="email"
              title="¿Prefieres que te escriba yo?"
              intro="Si no quieres escribir por WhatsApp ahora, déjame tus datos y te respondo por correo. Sin llamadas y sin compromiso."
              companyLabel="Consultorio o clínica"
              companyPlaceholder="Nombre de tu consultorio o clínica"
              messagePlaceholder="Quiero que mis pacientes me encuentren en Google y dejar de reagendar citas a mano."
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* BLOQUE 10 · Pie, con el mismo tratamiento oscuro del sitio principal */}
  <footer slot="below" class="grain on-dark relative bg-ink pt-16 pb-8 text-copy-dark">
    <span
      class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/16 to-transparent"
      aria-hidden="true"></span>
    <div class="container-page">
      <div
        class="flex flex-col gap-10 border-b border-line-dark pb-12 lg:flex-row lg:items-start lg:justify-between"
      >
        <div class="max-w-sm">
          <a href="/" class="text-white" aria-label="Soy Arquitecto Digital — ir al inicio">
            <Wordmark size="lg" />
          </a>
          <p class="mt-5 text-sm leading-relaxed">
            Arquitectura digital para profesionales de la salud en Venezuela.
          </p>
          <p class="mt-5 font-mono text-[11px] tracking-[0.18em] text-dim-dark uppercase">
            {site.person} · {site.location}
          </p>
        </div>

        <nav class="flex flex-col gap-2.5 text-sm" aria-label="Enlaces">
          <a
            href={site.url}
            class="font-semibold text-white transition-colors hover:text-brand-light"
          >
            soyarquitectodigital.info
          </a>
          <a href={`mailto:${site.email}`} class="transition-colors hover:text-brand-light">
            {site.email}
          </a>
          <a href="/legal/privacidad" class="transition-colors hover:text-brand-light">
            Aviso de privacidad
          </a>
        </nav>

        <div class="flex flex-col gap-3">
          <a
            href={waDiagnostico}
            target="_blank"
            rel="noopener noreferrer"
            data-cta="footer_whatsapp"
            class="inline-flex h-11 items-center justify-center gap-2 rounded-full bg-wa px-5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-wa-strong"
          >
            Hablemos por WhatsApp
          </a>
          <a
            href="#diagnostico"
            data-cta="footer_diagnostico"
            class="inline-flex h-11 items-center justify-center rounded-full border border-line-dark px-5 text-sm font-semibold text-white transition hover:border-line-dark-strong"
          >
            Diagnóstico gratis
          </a>
        </div>
      </div>

      <p class="pt-6 text-xs text-dim-dark">
        © {year} {site.name}
      </p>
    </div>
  </footer>

  <Fragment slot="below">
    <WhatsAppFloat tone="wa" href={waDiagnostico} label="Diagnóstico gratis" cta="float_diagnostico" />
  </Fragment>
</BaseLayout>
