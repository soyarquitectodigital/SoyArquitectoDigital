---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import { site, bookingUrl, whatsappDefault } from '../config';

const path = '/trayectoria';
const title = 'Trayectoria: una década dirigiendo tecnología real';
const description =
  'Más de 10 años de arquitectura y liderazgo técnico: CTO de una startup blockchain en EE.UU., +600 proyectos web en España, docencia universitaria y dirección de equipos en LATAM.';

const auditUrl = bookingUrl(
  'Hola Oswaldo, vi tu trayectoria y quiero la auditoría de 5 días para mi negocio.',
);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Trayectoria', item: new URL(path, site.url).href },
  ],
};
---

<BaseLayout title={title} description={description} schema={[breadcrumbs]}>
  <section class="tint-brand border-b border-line bg-paper pt-28 pb-14 sm:pt-32 sm:pb-16">
    <div class="container-page">
      <nav aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">Trayectoria</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16" data-reveal>
        <div>
          <Eyebrow number="—">Trayectoria</Eyebrow>
          <h1 class="mt-6 font-heading display-xl font-semibold text-text">
            Una década respondiendo <span class="text-gradient-brand">por sistemas reales</span>
          </h1>
        </div>
        <div>
          <p class="max-w-xl leading-relaxed text-copy">
            La arquitectura se aprende respondiendo por sistemas en producción: startups en EE.UU.,
            PYMEs europeas en el programa Kit Digital, docencia universitaria y equipos técnicos en
            LATAM. Esto es lo que hay detrás del criterio.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <Button href={auditUrl} external>Agendar diagnóstico</Button>
            <Button href={whatsappDefault} variant="ghost-light" external>Hablemos por WhatsApp</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ExperienceSection />

  <section class="bg-paper py-16 sm:py-20">
    <div class="container-page">
      <div
        class="flex flex-wrap items-center justify-between gap-6 rounded-card border border-brand/25 card-positive p-6 sm:p-8"
        data-reveal
      >
        <div class="max-w-xl">
          <h2 class="font-heading text-xl font-semibold text-text sm:text-2xl">
            ¿Quieres este criterio en tu negocio?
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-copy">
            Empieza por la auditoría de 5 días: informe ejecutivo, blueprint y roadmap de 90 días.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <Button href={auditUrl} external>Reservar auditoría de 5 días</Button>
          <Button href={whatsappDefault} variant="ghost-light" external>Hablemos por WhatsApp</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
