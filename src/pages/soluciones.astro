---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { services } from '../data/services';
import { layerSolutions } from '../data/solutions';
import { site, whatsapp, bookingUrl } from '../config';

const path = '/soluciones';
const title = 'Soluciones por capa de tu ecosistema digital';
const description =
  'Captación, conversión, datos, automatización e infraestructura: soluciones concretas por cada capa del ecosistema, más las tres formas de trabajar conmigo.';

const auditUrl = bookingUrl('Hola Oswaldo, quiero la auditoría de 5 días para mi ecosistema.');

const serviceIcons = [
  'M10.5 4.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12ZM15.2 15.2 19.5 19.5',
  'M8.5 7.5 4.5 12l4 4.5M15.5 7.5l4 4.5-4 4.5',
  'M12 3v3M12 18v3M3 12h3M18 12h3M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z',
];

const layerNumbers = ['01', '02', '03', '04', '05'];

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Soluciones de arquitectura digital',
  url: new URL(path, site.url).href,
  itemListElement: [
    ...services.map((service) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.name, description: service.description },
      ...(service.booking ? { url: site.calendarUrl } : {}),
    })),
    ...layerSolutions.map((solution) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: solution.name,
        description: solution.tagline,
        category: 'Arquitectura de ecosistemas digitales',
      },
    })),
  ],
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Soluciones', item: new URL(path, site.url).href },
  ],
};
---

<BaseLayout title={title} description={description} schema={[catalogSchema, breadcrumbs]}>
  <section class="section-pad tint-brand bg-paper pt-28 sm:pt-32">
    <div class="container-page">
      <nav aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">Soluciones</li>
        </ol>
      </nav>

      <div class="mt-8" data-reveal>
        <Eyebrow number="—">Soluciones</Eyebrow>
        <h1 class="mt-6 max-w-3xl font-heading display-xl font-semibold text-text">
          Soluciones por capa, no <span class="text-gradient-brand">parches sueltos</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-copy">
          Cada capa de tu ecosistema se puede resolver por separado, pero el resultado solo aparece
          cuando se conectan. Aquí están las tres formas de trabajar conmigo y las soluciones
          concretas por cada capa.
        </p>
      </div>

      <!-- Tres formas de trabajar -->
      <div class="mt-16">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <h2 class="max-w-xl font-heading display-lg font-semibold text-text">
            Tres formas de trabajar
          </h2>
          <p class="max-w-sm text-sm leading-relaxed text-copy">
            Empieza por donde duele menos: un diagnóstico de 5 días. Si ya tienes el plano claro,
            pasamos directo a construir o a dirigir.
          </p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3 xl:gap-6">
          {
            services.map((service, index) => (
              <article
                class="group tilt spotlight spotlight-dark hairline hairline-dark relative flex flex-col overflow-hidden rounded-card border border-line-dark bg-ink p-6 shadow-soft transition-shadow duration-300 hover:border-line-dark-strong hover:shadow-lift sm:p-7"
                data-reveal
                data-glow
                data-tilt
                style={`--delay:${index * 110}ms`}
              >
                <div
                  class="gradient-secondary pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div class="relative flex flex-1 flex-col">
                  <div class="flex items-center justify-between gap-4">
                    <span class="inline-flex items-center gap-3">
                      <span class="grid size-11 place-items-center rounded-2xl border border-line-dark bg-white/6 text-brand-light">
                        <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
                          <path
                            d={serviceIcons[index]}
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </span>
                      <span class="font-mono text-[11px] tracking-[0.22em] text-brand-light">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                    </span>
                    <span class="pill text-[11px]">{service.meta}</span>
                  </div>

                  <h3 class="font-heading mt-7 text-2xl leading-tight font-semibold text-white">
                    {service.name}
                  </h3>
                  <p class="mt-4 text-sm leading-relaxed text-copy-dark">{service.description}</p>

                  <ul class="mt-6 flex-1 space-y-2.5">
                    {service.deliverables.map((item) => (
                      <li class="flex items-start gap-2.5 text-sm text-copy-dark">
                        <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-light" fill="none" aria-hidden="true">
                          <path
                            d="m5 12.5 4.5 4.5L19 7.5"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>

                  <div class="mt-7 flex items-center justify-between gap-4 border-t border-line-dark pt-5">
                    <span class="font-mono text-[10px] tracking-[0.18em] text-dim-dark uppercase">
                      {service.priceLabel}
                    </span>
                    <a
                      href={service.booking
                        ? bookingUrl(`Hola Oswaldo, quiero reservar la ${service.name}.`)
                        : whatsapp(`Hola Oswaldo, me interesa el servicio de ${service.name}. ¿Lo vemos?`)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line-dark bg-white/6 px-4 py-2 text-sm font-semibold whitespace-nowrap text-brand-light transition duration-300 group-hover:border-brand-light/45 group-hover:bg-brand-light/12"
                    >
                      {service.booking ? 'Reservar auditoría' : 'Consultar'}
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <!-- Soluciones por capa -->
      <div class="mt-20">
        <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <h2 class="max-w-xl font-heading display-lg font-semibold text-text">
            Soluciones por capa del ecosistema
          </h2>
          <p class="max-w-sm text-sm leading-relaxed text-copy">
            Se pueden contratar por separado, pero se deciden juntas. Cada capa incluye medición para
            saber si funcionó.
          </p>
        </div>

        <ul class="mt-10 grid gap-5 lg:grid-cols-2 xl:gap-6">
          {
            layerSolutions.map((solution, index) => (
              <li class="card hairline spotlight relative p-6 sm:p-7" data-reveal data-glow style={`--delay:${index * 80}ms`}>
                <div class="flex items-center justify-between gap-4">
                  <span class="font-mono text-[11px] tracking-[0.22em] text-brand-ink">
                    {layerNumbers[index]}
                  </span>
                  <span class="font-mono text-[10px] tracking-[0.16em] text-dim uppercase">
                    {solution.meta}
                  </span>
                </div>

                <h3 class="font-heading mt-5 text-xl leading-tight font-semibold text-text sm:text-2xl">
                  {solution.name}
                </h3>
                <p class="mt-2 text-sm font-semibold text-brand-ink">{solution.tagline}</p>
                <p class="mt-4 text-sm leading-relaxed text-copy">{solution.description}</p>

                <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
                  {solution.deliverables.map((item) => (
                    <li class="flex items-start gap-2.5 text-sm text-copy">
                      <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-ink" fill="none" aria-hidden="true">
                        <path
                          d="m5 12.5 4.5 4.5L19 7.5"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>

                <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-line pt-5">
                  <a
                    href={whatsapp(`Hola Oswaldo, me interesa la solución de ${solution.name}.`)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-4 py-2 text-sm font-semibold text-brand-ink transition duration-300 hover:border-brand/45 hover:bg-brand/8"
                  >
                    Consultar esta capa
                  </a>
                  <a
                    href="/herramientas/diagnostico-ecosistema-digital"
                    class="text-sm font-semibold text-copy underline decoration-line decoration-2 underline-offset-4 transition-colors hover:text-text"
                  >
                    Medir cómo está hoy
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Cierre -->
      <div class="mt-16 rounded-card border border-line bg-surface p-6 shadow-card sm:p-8" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="font-heading text-2xl font-semibold text-text">
              ¿No sabes por qué capa empezar?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-copy">
              El diagnóstico te da el orden en 3 minutos. Y si quieres que lo revise contigo, la
              auditoría de 5 días incluye el blueprint del ecosistema y un roadmap de 90 días.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <Button href="/herramientas/diagnostico-ecosistema-digital">Hacer el diagnóstico</Button>
            <Button href={auditUrl} variant="ghost-light" external>Reservar auditoría</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
