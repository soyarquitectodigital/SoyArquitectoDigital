---
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import ToolCard from '../components/tools/ToolCard.astro';
import { tools, liveTools, upcomingTools } from '../data/tools';
import { site, bookingUrl } from '../config';

const path = '/soluciones';
const title = 'Soluciones: diagnóstico y auditoría de tu ecosistema digital';
const description =
  'Herramientas gratuitas de diagnóstico y auditoría de arquitectura de software para PYMEs: mide tu ecosistema digital por capas, calcula el coste oculto y prioriza qué resolver primero.';

const auditUrl = bookingUrl('Hola Oswaldo, vi las soluciones y quiero la auditoría de 5 días.');

const featured = liveTools[0];
const soon = upcomingTools;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Soluciones', item: new URL(path, site.url).href },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Soluciones de Soy Arquitecto Digital',
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.name,
    description: tool.tagline,
    ...(tool.href ? { url: new URL(tool.href, site.url).href } : {}),
  })),
};
---

<BaseLayout title={title} description={description} schema={[itemListSchema, breadcrumbs]}>
  <section class="tint-brand bg-paper pt-28 pb-20 sm:pt-32">
    <div class="container-page">
      <nav aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">Soluciones</li>
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-end lg:gap-16" data-reveal>
        <div>
          <Eyebrow number="—">Soluciones</Eyebrow>
          <h1 class="mt-6 font-heading display-xl font-semibold text-text">
            Las soluciones que estoy <span class="text-gradient-brand">construyendo</span>
          </h1>
        </div>

        <div class="lg:pb-2">
          <p class="text-lg leading-relaxed text-copy">
            Herramientas propias para diagnosticar y ordenar ecosistemas digitales: las mismas que uso
            en mis auditorías, abiertas para que midas tu situación antes de invertir. Sin registro,
            sin coste y calculadas en tu navegador.
          </p>
          <dl class="mt-7 grid grid-cols-2 gap-4 border-t border-line pt-5">
            <div>
              <dt class="font-mono text-[10px] tracking-[0.18em] text-dim uppercase">Disponibles</dt>
              <dd class="font-heading mt-1 text-3xl leading-none text-brand-ink">
                {liveTools.length}
              </dd>
            </div>
            <div>
              <dt class="font-mono text-[10px] tracking-[0.18em] text-dim uppercase">
                En preparación
              </dt>
              <dd class="font-heading mt-1 text-3xl leading-none text-text">{soon.length}</dd>
            </div>
          </dl>
          <p class="mt-5 text-sm leading-relaxed text-dim">
            Publico una nueva cada mes. Si necesitas alguna que no está en la lista, escríbeme y lo
            valoramos.
          </p>
        </div>
      </div>

      <ul class="mt-14 grid gap-5">
        {featured && <ToolCard tool={featured} variant="wide" />}
      </ul>

      <div class="mt-14 flex flex-wrap items-end justify-between gap-4" data-reveal>
        <h2 class="font-heading text-2xl font-semibold text-text sm:text-3xl">En preparación</h2>
        <p class="max-w-md text-sm leading-relaxed text-copy">
          Las siguientes herramientas del catálogo. Si alguna te urge, escríbeme y la priorizo.
        </p>
      </div>

      <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {soon.map((tool, index) => <ToolCard tool={tool} variant="compact" delay={index * 80} />)}
      </ul>

      <div class="mt-16 rounded-card border border-line bg-surface p-6 shadow-card sm:p-8" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="font-heading text-2xl font-semibold text-text">
              ¿Necesitas el diagnóstico hecho por mí?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-copy">
              La auditoría de 5 días incluye la revisión técnica completa, el blueprint del ecosistema
              y un roadmap priorizado de 90 días con recomendaciones sobre tu caso.
            </p>
          </div>
          <Button href={auditUrl} size="lg" external>Reservar auditoría de 5 días</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
