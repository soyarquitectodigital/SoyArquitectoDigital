---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Button from '../../components/Button.astro';
import { tools } from '../../data/tools';
import { site, bookingUrl } from '../../config';

const title = 'Herramientas para auditar tu ecosistema digital';
const description =
  'Herramientas gratuitas para evaluar tu ecosistema digital antes de invertir: diagnóstico por capas, calculadora de coste oculto, checklist de señales y auditoría express.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Herramientas de Soy Arquitecto Digital',
  itemListElement: tools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.name,
    ...(tool.href ? { url: new URL(tool.href, site.url).href } : {}),
  })),
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Herramientas',
      item: new URL('/herramientas', site.url).href,
    },
  ],
};

const icons: Record<string, string> = {
  diagnostico: 'M10.5 4.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12ZM15.2 15.2 19.5 19.5',
  calculadora: 'M5 4.5h14v15H5zM8 8.5h8M8 12h2M12 12h2M16 12h.01M8 15.5h2M12 15.5h2M16 15.5h.01',
  checklist: 'M4.5 6.5l2 2 3-3M4.5 12.5l2 2 3-3M4.5 18.5l2 2 3-3M12 7.5h8M12 13.5h8M12 19.5h8',
  auditoria: 'M12 3v3M12 18v3M3 12h3M18 12h3M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
};

const auditUrl = bookingUrl('Hola Oswaldo, vi tus herramientas y quiero la auditoría de 5 días.');
---

<BaseLayout title={title} description={description} schema={[itemListSchema, breadcrumbs]}>
  <section class="section-pad tint-brand bg-paper pt-28 sm:pt-32">
    <div class="container-page">
      <nav class="print-hide" aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">Herramientas</li>
        </ol>
      </nav>

      <div class="mt-8" data-reveal>
        <Eyebrow number="—">Herramientas</Eyebrow>
        <h1 class="mt-6 max-w-3xl font-heading display-xl font-semibold text-text">
          Herramientas para decidir con <span class="text-gradient-brand">datos</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-copy">
          Son las mismas que uso en mis diagnósticos, abiertas para que puedas evaluar tu ecosistema
          antes de invertir. Gratis, sin registro y con el resultado calculado en tu navegador.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 lg:grid-cols-2">
        {
          tools.map((tool) => (
            <li
              class="card hairline spotlight relative flex flex-col p-6 sm:p-7"
              data-reveal
              data-glow
            >
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="grid size-11 place-items-center rounded-2xl border border-line bg-paper text-brand-ink">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
                    <path
                      d={icons[tool.icon]}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span
                  class:list={[
                    'font-mono text-[11px] tracking-[0.2em] uppercase',
                    tool.status === 'live' ? 'text-brand-ink' : 'text-dim',
                  ]}
                >
                  {tool.status === 'live' ? 'Disponible' : 'En preparación'}
                </span>
              </div>

              <h2 class="font-heading mt-6 text-2xl leading-tight font-semibold text-text">
                {tool.name}
              </h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-copy">{tool.tagline}</p>

              <p class="mt-5 font-mono text-[11px] tracking-[0.18em] text-dim uppercase">
                {tool.duration}
              </p>

              <div class="mt-6 border-t border-line pt-5">
                {tool.href ? (
                  <a href={tool.href} class="qc-btn-primary">
                    Abrir herramienta
                    <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
                      <path
                        d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                ) : (
                  <p class="text-sm text-dim">
                    La publico en las próximas semanas. Mientras tanto, si te urge, escríbeme.
                  </p>
                )}
              </div>
            </li>
          ))
        }
      </ul>

      <div class="mt-14 rounded-card border border-line bg-surface p-6 shadow-card sm:p-8" data-reveal>
        <div class="flex flex-wrap items-center justify-between gap-6">
          <div class="max-w-xl">
            <h2 class="font-heading text-2xl font-semibold text-text">
              ¿Prefieres el diagnóstico hecho por mí?
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-copy">
              La auditoría de 5 días incluye la revisión técnica completa, el blueprint del
              ecosistema y un roadmap priorizado de 90 días.
            </p>
          </div>
          <Button href={auditUrl} size="lg" external>Reservar auditoría de 5 días</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
