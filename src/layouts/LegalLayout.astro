---
import BaseLayout from './BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="tint-brand bg-paper pt-28 pb-20 sm:pt-32">
    <div class="container-page">
      <nav aria-label="Ruta de navegación">
        <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          <li><a href="/" class="transition-colors hover:text-text">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-text">{title}</li>
        </ol>
      </nav>

      <div class="mt-8 max-w-2xl">
        <Eyebrow number="—">Legal</Eyebrow>
        <h1 class="mt-6 font-heading display-lg font-semibold text-text">{title}</h1>
        <p class="mt-4 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
          Última actualización: {updated}
        </p>
      </div>

      <div class="legal mt-10 max-w-3xl rounded-card border border-line bg-surface p-6 shadow-card sm:p-9">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>
