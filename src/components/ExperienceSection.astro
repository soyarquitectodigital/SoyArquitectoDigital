---
import Eyebrow from './Eyebrow.astro';
import { experience, teaching, skills, certifications } from '../data/cv';

const metrics = [
  {
    value: '+600',
    count: 600,
    prefix: '+',
    label: 'proyectos web entregados en el programa Kit Digital (España).',
  },
  {
    value: '35%',
    count: 35,
    suffix: '%',
    label: 'más rápido en entregas tras coordinar equipos multidisciplinarios.',
  },
  {
    value: '40%',
    count: 40,
    suffix: '%',
    label: 'menos incidentes post-lanzamiento con flujos de control de calidad.',
  },
  {
    value: 'CTO',
    label: 'startup blockchain en EE.UU.: arquitectura, CI/CD y OKRs técnicos.',
  },
];
---

<section id="trayectoria" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
  <div class="container-page">
    <Eyebrow number="05">Trayectoria y resultados</Eyebrow>

    <div class="mt-8 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-end lg:gap-16 xl:gap-24" data-reveal>
      <h2 class="font-heading display-lg font-semibold text-text">
        Resultados que se pueden <span class="text-brand-ink">medir</span>
      </h2>
      <p class="max-w-xl leading-relaxed text-copy">
        CTO de una startup blockchain en EE.UU., +600 proyectos web para PYMEs europeas, docencia
        universitaria y una década dirigiendo equipos. La arquitectura se aprende respondiendo por
        sistemas reales.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        metrics.map((metric, index) => (
          <div
            class="card hairline spotlight relative p-5"
            data-glow
            data-reveal
            style={`--delay:${index * 90}ms`}
          >
            {metric.count ? (
              <p
                class="font-heading text-gradient-brand text-3xl leading-none"
                data-count={metric.count}
                data-prefix={metric.prefix ?? ''}
                data-suffix={metric.suffix ?? ''}
              >
                {`${metric.prefix ?? ''}${metric.count}${metric.suffix ?? ''}`}
              </p>
            ) : (
              <p class="font-heading text-gradient-brand text-3xl leading-none">{metric.value}</p>
            )}
            <p class="mt-3 text-sm leading-relaxed text-copy">{metric.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
      <div>
        <h3 class="font-heading text-2xl font-semibold text-text" data-reveal>
          Dónde se ha construido este criterio
        </h3>

        <ol class="mt-8">
          {
            experience.map((job, index) => (
              <li
                class="relative pb-9 pl-9 last:pb-0 sm:pl-10"
                data-reveal
                style={`--delay:${index * 80}ms`}
              >
                {index < experience.length - 1 && (
                  <span class="absolute top-5 bottom-0 left-[7px] w-px bg-line" aria-hidden="true" />
                )}
                <span
                  class:list={[
                    'absolute top-1.5 left-0 grid size-3.5 place-items-center rounded-full border-2',
                    job.current ? 'dot-glow border-brand bg-brand' : 'border-line-strong bg-surface',
                  ]}
                  aria-hidden="true"
                />

                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h4 class="font-heading text-lg font-semibold text-text sm:text-xl">
                    {job.role}
                  </h4>
                  <span class="font-mono text-[11px] tracking-[0.14em] text-dim uppercase">
                    {job.period}
                  </span>
                </div>
                <p class="mt-1 text-sm font-semibold text-brand-ink">
                  {job.company} <span class="font-normal text-dim">· {job.location}</span>
                </p>

                <ul class="mt-3 space-y-1.5">
                  {job.highlights.map((item) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-copy">
                      <span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-brand-2" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                {job.subRoles?.map((sub) => (
                  <div class="mt-4 rounded-2xl border border-line bg-paper px-4 py-3">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                      <p class="text-sm font-semibold text-text">{sub.role}</p>
                      <span class="font-mono text-[10px] tracking-[0.14em] text-dim uppercase">
                        {sub.period}
                      </span>
                    </div>
                    {sub.highlights.map((item) => (
                      <p class="mt-1.5 text-sm leading-relaxed text-copy">{item}</p>
                    ))}
                  </div>
                ))}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="space-y-5 lg:sticky lg:top-28 lg:self-start" data-reveal>
        <div class="card p-6">
          <p class="number-tag">Docencia universitaria</p>
          <p class="mt-3 text-sm leading-relaxed text-copy">
            Profesor de las materias que hoy sostienen mi trabajo:
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            {teaching.map((item) => <span class="chip">{item}</span>)}
          </div>
        </div>

        <div class="card p-6">
          <p class="number-tag">Stack con el que construyo</p>
          <ul class="mt-4 space-y-3">
            {
              skills.map((group) => (
                <li>
                  <p class="text-xs font-semibold tracking-wide text-text uppercase">
                    {group.label}
                  </p>
                  <p class="mt-1 text-sm leading-relaxed text-copy">{group.items.join(' · ')}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="card p-6">
          <p class="number-tag">Certificaciones</p>
          <ul class="mt-4 space-y-2">
            {
              certifications.map((item) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-copy">
                  <span class="mt-[7px] size-1.5 shrink-0 rounded-full bg-brand-2" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
