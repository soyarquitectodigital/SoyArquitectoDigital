---
import Wordmark from './Wordmark.astro';
import SocialLinks from './SocialLinks.astro';
import { site, socialHandle, whatsappDefault } from '../config';

const year = new Date().getFullYear();

const links = [
  { href: '#problema', label: 'El problema' },
  { href: '/herramientas', label: 'Herramientas' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#enfoque', label: 'Enfoque' },
  { href: '#trayectoria', label: 'Trayectoria' },
  { href: '#preguntas', label: 'Preguntas' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="grain relative bg-ink pt-16 pb-8 text-copy-dark">
  <span
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/16 to-transparent"
    aria-hidden="true"></span>
  <div class="container-page">
    <div class="flex flex-col gap-10 border-b border-line-dark pb-12 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-sm">
        <span class="text-white"><Wordmark size="lg" /></span>
        <p class="mt-5 text-sm leading-relaxed">
          Arquitectura de ecosistemas digitales y dirección tecnológica para empresas en
          crecimiento. Un solo responsable, cero humo.
        </p>
        <p class="mt-5 font-mono text-[11px] tracking-[0.18em] text-dim-dark uppercase">
          Una firma de {site.studio}
        </p>
        <p class="mt-2 font-mono text-[11px] tracking-[0.18em] text-dim-dark uppercase">
          {site.person} · {site.location}
        </p>
        <div class="mt-6">
          <SocialLinks tone="dark" size="md" />
          <p class="mt-3 font-mono text-[11px] tracking-[0.14em] text-dim-dark">
            {socialHandle} en todas las redes
          </p>
        </div>
      </div>

      <nav class="grid grid-cols-2 gap-x-12 gap-y-2.5" aria-label="Pie de página">
        {
          links.map((link) => (
            <a href={link.href} class="text-sm font-medium transition-colors hover:text-brand-light">
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex flex-col gap-3">
        <a
          href={whatsappDefault}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center justify-center rounded-full bg-brand px-5 text-sm font-semibold text-on-brand transition hover:-translate-y-0.5"
        >
          Hablemos por WhatsApp
        </a>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm transition-colors hover:text-white"
        >
          <svg viewBox="0 0 20 20" class="size-4 text-brand-light" fill="none" aria-hidden="true">
            <path
              d="M3.5 5.5h13v9h-13zM3.5 6l6.5 5 6.5-5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          {site.email}
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm transition-colors hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="size-4 text-brand-light" fill="currentColor" aria-hidden="true">
            <path
              d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12M7.12 20.45H3.56V9h3.56zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0">
            </path>
          </svg>
          LinkedIn
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 pt-6 text-xs text-dim-dark sm:flex-row">
      <p>© {year} {site.name} · {site.studio}</p>
      <p class="font-mono tracking-[0.14em] uppercase">Hecho con Astro · Sin cookies · Sin rastreadores</p>
    </div>
  </div>
</footer>
