---
import Eyebrow from './Eyebrow.astro';
import { cases } from '../data/cases';

// La sección solo existe cuando hay casos cargados en src/data/cases.ts.
// Si algún día se activa, revisar la numeración de las secciones siguientes
// (QualificationSection, CtaSection y FaqSection) para insertarla en la serie.
const hasCases = cases.length > 0;

const steps = [
  { key: 'problem', label: 'El problema' },
  { key: 'solution', label: 'La solución' },
  { key: 'result', label: 'El resultado' },
] as const;

const stepTone: Record<(typeof steps)[number]['key'], string> = {
  problem: 'text-warn',
  solution: 'text-brand-ink',
  result: 'text-ok-ink',
};
---

{
  hasCases && (
    <section id="casos" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
      <div class="container-page">
        <Eyebrow number="—">Casos de estudio</Eyebrow>

        <div
          class="mt-8 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-end lg:gap-16 xl:gap-24"
          data-reveal
        >
          <h2 class="font-heading display-lg font-semibold text-text">
            Problemas reales, <span class="text-brand-ink">decisiones concretas</span>
          </h2>
          <p class="max-w-xl leading-relaxed text-copy">
            Cada caso cuenta lo mismo: qué estaba atascado, qué decidí y qué cambió después. Sin
            jerga y sin inflar cifras.
          </p>
        </div>

        <ol class="mt-12 space-y-6">
          {cases.map((item, index) => (
            <li>
              <article
                class="card hairline spotlight relative p-6 sm:p-8"
                data-reveal
                data-glow
                style={`--delay:${index * 80}ms`}
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
                  <div class="min-w-0">
                    <p class="font-mono text-[11px] tracking-[0.2em] text-brand-ink uppercase">
                      {String(index + 1).padStart(2, '0')} · {item.sector}
                    </p>
                    <h3 class="font-heading mt-2 text-xl leading-tight font-semibold text-text sm:text-2xl">
                      {item.title}
                    </h3>
                  </div>
                  <p class="font-mono text-[11px] tracking-[0.14em] text-dim uppercase">
                    {item.client} · {item.period}
                  </p>
                </div>

                <div class="mt-7 grid gap-6 border-t border-line pt-6 lg:grid-cols-3 lg:gap-8">
                  {steps.map((step) => (
                    <div>
                      <p
                        class:list={[
                          'font-mono text-[11px] tracking-[0.18em] uppercase',
                          stepTone[step.key],
                        ]}
                      >
                        {step.label}
                      </p>
                      <p class="mt-2.5 text-sm leading-relaxed text-copy">{item[step.key]}</p>
                    </div>
                  ))}
                </div>

                {item.metrics.length > 0 && (
                  <dl class="mt-7 grid gap-4 border-t border-line pt-6 sm:grid-cols-3">
                    {item.metrics.map((metric) => (
                      <div>
                        <dt class="sr-only">{metric.label}</dt>
                        <dd>
                          <span class="font-heading text-gradient-brand block text-2xl leading-none">
                            {metric.value}
                          </span>
                          <span class="mt-1.5 block text-xs leading-relaxed text-copy">
                            {metric.label}
                          </span>
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}

                {item.stack.length > 0 && (
                  <div class="mt-6 flex flex-wrap gap-2">
                    {item.stack.map((tech) => (
                      <span class="chip">{tech}</span>
                    ))}
                  </div>
                )}

                {item.quote && (
                  <figure class="mt-7 rounded-card border border-line bg-paper p-5">
                    <blockquote class="font-heading text-base leading-snug text-text">
                      «{item.quote.text}»
                    </blockquote>
                    <figcaption class="mt-3 font-mono text-[11px] tracking-[0.16em] text-dim uppercase">
                      {item.quote.author} · {item.quote.role}
                    </figcaption>
                  </figure>
                )}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}
