---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { whatsappDefault } from '../config';

interface Props {
  href?: string;
  /** 'wa' usa el verde accesible de WhatsApp; 'brand' el azul del sitio. */
  tone?: 'brand' | 'wa';
  label?: string;
}

const { href = whatsappDefault, tone = 'brand', label = 'Hablemos' } = Astro.props;

const tones = {
  brand:
    'bg-brand text-on-brand shadow-[0_18px_40px_-12px_rgba(37,99,235,0.7)] hover:shadow-[0_22px_48px_-12px_rgba(37,99,235,0.85)]',
  wa: 'bg-wa text-white shadow-[0_18px_40px_-12px_rgba(11,122,62,0.75)] hover:bg-wa-strong hover:shadow-[0_22px_48px_-12px_rgba(11,122,62,0.9)]',
};
---

<a
  id="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Abrir conversación de WhatsApp"
  class:list={[
    'fixed right-4 bottom-4 z-40 inline-flex h-14 items-center gap-3 rounded-full pr-5 pl-4 text-sm font-semibold ring-1 ring-white/20 transition hover:-translate-y-0.5 sm:right-6 sm:bottom-6',
    tones[tone],
  ]}
>
  <span class="grid size-8 place-items-center rounded-full bg-white/15">
    <WhatsAppIcon class="size-5" />
  </span>
  <span>{label}</span>
</a>
