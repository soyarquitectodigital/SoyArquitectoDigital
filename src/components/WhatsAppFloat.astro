---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { whatsappDefault } from '../config';

interface Props {
  href?: string;
  /** 'wa' usa el verde accesible de WhatsApp; 'brand' el azul del sitio. */
  tone?: 'brand' | 'wa';
  label?: string;
  /** Identificador para atribución de clics (data-cta). Opcional. */
  cta?: string;
}

const { href = whatsappDefault, tone = 'brand', label = 'Hablemos', cta } = Astro.props;

/*
 * En escritorio es un círculo que se expande al pasar el cursor (con el
 * nombre solo cuando hace falta); en móvil y tablet se queda como píldora
 * porque ahí no existe el hover. El punto verde es la señal de «en línea».
 */
const tones = {
  brand: {
    button:
      'bg-brand text-on-brand shadow-[0_18px_40px_-16px_rgba(10,31,51,0.6)] hover:shadow-[0_24px_50px_-18px_rgba(10,31,51,0.7)]',
    dot: 'bg-ok ring-brand',
  },
  wa: {
    button:
      'bg-wa text-white shadow-[0_18px_40px_-16px_rgba(8,77,40,0.6)] hover:bg-wa-strong hover:shadow-[0_24px_50px_-18px_rgba(8,77,40,0.7)]',
    dot: 'bg-ok ring-wa',
  },
};
---

<a
  id="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Abrir conversación de WhatsApp"
  data-cta={cta}
  class:list={[
    'group/wa fixed right-4 bottom-4 z-40 inline-flex h-14 items-center overflow-hidden rounded-full pr-4 transition-all duration-300 hover:-translate-y-0.5 sm:right-6 sm:bottom-6 lg:pr-0 lg:hover:pr-5',
    tones[tone].button,
  ]}
>
  <span class="relative grid size-14 shrink-0 place-items-center">
    <WhatsAppIcon class="size-6" />
    <span
      class:list={['absolute top-3 right-3 size-2.5 rounded-full ring-2', tones[tone].dot]}
      aria-hidden="true"
    ></span>
  </span>
  <span
    class="grid min-w-0 grid-cols-[1fr] transition-[grid-template-columns] duration-300 lg:grid-cols-[0fr] lg:group-hover/wa:grid-cols-[1fr] lg:group-focus-visible/wa:grid-cols-[1fr]"
  >
    <span class="min-w-0 overflow-hidden text-sm font-semibold whitespace-nowrap">{label}</span>
  </span>
</a>
