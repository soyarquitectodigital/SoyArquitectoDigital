---
import Button from './Button.astro';
import { bookingUrl, whatsappDefault } from '../config';

const auditUrl = bookingUrl(
  'Hola Oswaldo, quiero reservar la auditoría digital de 5 días para mi negocio.',
);

/*
 * El titular se anima palabra por palabra; el par «ecosistemas digitales» va
 * en el azul claro de marca, igual que en el resto del sitio.
 */
const headline = [
  { text: 'Arquitectura' },
  { text: 'de' },
  { text: 'ecosistemas', accent: true },
  { text: 'digitales', accent: true },
  { text: 'para' },
  { text: 'empresas' },
  { text: 'que' },
  { text: 'escalan.' },
];
---

<section id="inicio" class="grain vignette relative flex min-h-svh flex-col justify-center overflow-hidden bg-ink">
  {/*
    Dos auroras y la retícula de píxeles animada en canvas (brillo uniforme,
    chispas y reacción al cursor). La ilustración premium se decide aparte.
  */}
  <div class="hero-aurora" aria-hidden="true">
    <span class="aurora aurora-1"></span>
    <span class="aurora aurora-2"></span>
  </div>
  <canvas id="ecosystem-canvas" class="absolute inset-0 h-full w-full" aria-hidden="true"
  ></canvas>

  <div class="container-page relative pt-28 pb-14 text-center sm:pt-32 lg:pt-36 lg:pb-16">
    <div class="mx-auto max-w-3xl xl:max-w-4xl">
      <p class="pill animate-float text-white">
        <span class="relative inline-flex size-2 text-brand-light">
          <span class="pulse-dot absolute inset-0 rounded-full bg-brand-light"></span>
          <span class="relative inline-block size-2 rounded-full bg-brand-light"></span>
        </span>
        Disponible para nuevos proyectos
      </p>

      <h1 class="mt-7 display-xl text-white">
        {
          headline.map((token, index) => (
            <>
              <span class="word-mask">
                <span
                  class:list={['word-in', token.accent && 'text-brand-light']}
                  style={`--d:${120 + index * 70}ms`}
                >
                  {token.text}
                </span>
              </span>{' '}
            </>
          ))
        }
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-xl leading-snug font-medium text-white sm:text-2xl">
        Unifico sistemas, automatizo procesos y respondo por toda tu arquitectura, como tu <span
          class="text-brand-light">CTO externo</span
        >.
      </p>

      <p class="mt-5 flex items-center justify-center gap-2.5 font-mono text-sm text-copy-dark sm:text-[15px]">
        <span class="text-brand-light" aria-hidden="true">&gt;</span>
        <span
          class="text-white"
          data-typewriter
          data-words="Integro tus sistemas: APIs, CRM y ERP|Automatizo procesos con n8n e IA|Desarrollo aplicaciones web a medida|Dirijo tu tecnología como CTO externo"
          >Integro tus sistemas: APIs, CRM y ERP</span
        >
        <span class="type-caret text-brand-light" aria-hidden="true">&nbsp;</span>
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <Button href={auditUrl} size="lg" external>Reservar auditoría de 5 días</Button>
        <Button href={whatsappDefault} variant="ghost-dark" size="lg" external>
          Hablemos por WhatsApp
        </Button>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-2.5">
        <span class="pill text-white">
          <span class="size-1.5 rounded-full bg-brand-light" aria-hidden="true"></span>
          +600 proyectos entregados
        </span>
        <span class="pill text-white">
          <span class="size-1.5 rounded-full bg-brand-light" aria-hidden="true"></span>
          Liderazgo técnico en EE. UU. y LATAM
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  // Con View Transitions el módulo se evalúa una sola vez en toda la sesión, así
  // que el arranque se repite en cada `astro:page-load`.
  function initHeroCanvas() {
    const canvas = document.getElementById('ecosystem-canvas') as HTMLCanvasElement | null;
    const hero = document.getElementById('inicio');
    if (!canvas || !hero || canvas.dataset.ready === '1') return;
    canvas.dataset.ready = '1';
    const ctx = canvas.getContext('2d');
    const prefersReduced = window.__motion
      ? !window.__motion.allowed
      : window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let width = 0;
    let height = 0;
    let cell = 17;
    let cols = 0;
    let rows = 0;
    let raf = 0;
    let visible = true;
    let observer: IntersectionObserver | null = null;
    let time = 0;
    let lastFrame = performance.now();
    let noise = new Float32Array(0);
    const pointer = { x: -9999, y: -9999 };
    const sparks: { c: number; r: number; life: number }[] = [];

    function spawnSparks() {
      sparks.length = 0;
      for (let i = 0; i < 24; i++) {
        sparks.push({
          c: Math.floor(Math.random() * cols),
          r: Math.floor(Math.random() * rows),
          life: Math.random(),
        });
      }
    }

    function resize() {
      if (!canvas || !hero) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = hero.clientWidth;
      height = hero.clientHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Retícula de píxeles: más densa en móvil, siempre con presupuesto acotado.
      cell = width < 720 ? 13 : 17;
      cols = Math.ceil(width / cell);
      rows = Math.ceil(height / cell);
      const total = cols * rows;
      noise = new Float32Array(total);
      for (let i = 0; i < total; i++) noise[i] = Math.random() * Math.PI * 2;
      spawnSparks();
    }

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      const size = Math.round(cell * 0.66);
      const pointerCol = Math.floor(pointer.x / cell);
      const pointerRow = Math.floor(pointer.y / cell);
      const glowCells = 7;

      // Bloque uniforme: cada píxel existe siempre y el brillo «respira» en
      // manchas muy amplias, sin huecos — como una pantalla LED.
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const n = noise[r * cols + c];
          const shimmer = 0.5 + 0.5 * Math.sin(c * 0.16 + r * 0.12 + time * 0.5 + n * 0.45);
          let alpha = 0.05 + shimmer * 0.075;

          // El cursor aviva la retícula a su alrededor.
          if (Math.abs(c - pointerCol) <= glowCells && Math.abs(r - pointerRow) <= glowCells) {
            const dx = c - pointerCol;
            const dy = r - pointerRow;
            const d = Math.sqrt(dx * dx + dy * dy);
            if (d < glowCells) alpha += (1 - d / glowCells) * 0.32;
          }

          ctx.fillStyle = `rgba(127, 169, 227, ${alpha})`;
          ctx.fillRect(c * cell + (cell - size) / 2, r * cell + (cell - size) / 2, size, size);
        }
      }

      // Chispas: píxeles que encienden y apagan, como datos viajando.
      for (const spark of sparks) {
        if (!prefersReduced) {
          spark.life += 0.02;
          if (spark.life >= 1) {
            spark.c = Math.floor(Math.random() * cols);
            spark.r = Math.floor(Math.random() * rows);
            spark.life = 0;
          }
        }
        const alpha = Math.sin(Math.min(1, Math.max(0, spark.life)) * Math.PI) * 0.8;
        if (alpha <= 0.02) continue;
        const sparkSize = size + 2;
        ctx.fillStyle = `rgba(226, 237, 251, ${alpha})`;
        ctx.fillRect(
          spark.c * cell + (cell - sparkSize) / 2,
          spark.r * cell + (cell - sparkSize) / 2,
          sparkSize,
          sparkSize,
        );
      }
    }

    function loop(now: number) {
      const dt = Math.min(0.05, (now - lastFrame) / 1000);
      lastFrame = now;
      if (!prefersReduced) time += dt;
      draw();
      if (visible) raf = requestAnimationFrame(loop);
    }

    function start() {
      cancelAnimationFrame(raf);
      if (prefersReduced) {
        draw();
        return;
      }
      if (visible) {
        lastFrame = performance.now();
        raf = requestAnimationFrame(loop);
      }
    }

    resize();
    start();

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        start();
      }, 160);
    };
    window.addEventListener('resize', onResize);

    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      pointer.x = event.clientX - rect.left;
      pointer.y = event.clientY - rect.top;
    });

    hero.addEventListener('pointerleave', () => {
      pointer.x = -9999;
      pointer.y = -9999;
    });

    if ('IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        (entries) => {
          visible = entries[0]?.isIntersecting ?? true;
          if (visible) {
            start();
          } else {
            cancelAnimationFrame(raf);
          }
        },
        { threshold: 0.05 },
      );
      observer.observe(hero);
    }

    // Al salir de la página hay que parar el bucle y soltar observador y
    // listener: si no, el rAF seguiría dibujando sobre un canvas ya
    // desconectado y cada visita acumularía un listener de `resize`.
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.clearTimeout(resizeTimer);
        cancelAnimationFrame(raf);
        window.removeEventListener('resize', onResize);
        observer?.disconnect();
      },
      { once: true },
    );
  }

  document.addEventListener('astro:page-load', initHeroCanvas);
  initHeroCanvas();
</script>
