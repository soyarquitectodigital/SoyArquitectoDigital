---
import { whatsapp, bookingUrl } from '../../config';
import { quiz } from '../../data/tools/diagnostico';

const auditUrl = bookingUrl('Hola Oswaldo, hice el diagnóstico de ecosistema digital.');
---

<div class="rounded-card border border-line bg-surface p-6 shadow-card sm:p-8 lg:p-10">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="font-mono text-[11px] tracking-[0.22em] text-brand-ink uppercase">
      Informe de diagnóstico
    </p>
    <p class="font-mono text-[11px] tracking-[0.18em] text-dim uppercase" data-report-type>
      —
    </p>
  </div>

  <div class="mt-8 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-12">
    <div>
      <div class="flex items-center gap-6">
        <div class="score-ring" data-score-ring style="--p:0" role="img" aria-label="Puntaje del ecosistema">
          <svg viewBox="0 0 120 120" aria-hidden="true">
            <circle class="score-ring-track" cx="60" cy="60" r="52"></circle>
            <circle class="score-ring-arc" data-score-arc cx="60" cy="60" r="52"></circle>
          </svg>
          <span class="score-ring-value">
            <span data-score-value>0%</span>
          </span>
        </div>
        <div class="min-w-0">
          <p class="band-label" data-score-band>—</p>
          <p class="mt-2 text-sm leading-relaxed text-copy" data-score-summary>—</p>
        </div>
      </div>

      <dl class="mt-8 grid grid-cols-2 gap-4 border-t border-line pt-6">
        <div>
          <dt class="font-mono text-[10px] tracking-[0.18em] text-dim uppercase">Preguntas</dt>
          <dd class="mt-1 text-lg font-semibold text-text" data-score-answered>—</dd>
        </div>
        <div>
          <dt class="font-mono text-[10px] tracking-[0.18em] text-dim uppercase">Capas evaluadas</dt>
          <dd class="mt-1 text-lg font-semibold text-text">5</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap gap-3 print-hide">
        <a
          href={auditUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-11 items-center gap-2 rounded-full bg-brand px-5 text-sm font-semibold text-on-brand transition hover:-translate-y-0.5"
        >
          Reservar auditoría de 5 días
        </a>
        <a
          href={whatsapp('Hola Oswaldo, hice el diagnóstico de ecosistema digital.')}
          target="_blank"
          rel="noopener noreferrer"
          data-cta-whatsapp
          class="inline-flex h-11 items-center gap-2 rounded-full border border-line bg-surface px-5 text-sm font-semibold text-text transition hover:-translate-y-0.5 hover:border-line-strong"
        >
          Comentarlo por WhatsApp
        </a>
      </div>

      <div class="mt-3 flex flex-wrap gap-3 print-hide">
        <button
          type="button"
          data-quiz-copy
          class="inline-flex h-9 items-center rounded-full border border-line px-4 text-xs font-semibold text-copy transition hover:border-line-strong hover:text-text"
        >
          Copiar resumen
        </button>
        <button
          type="button"
          data-quiz-print
          class="inline-flex h-9 items-center rounded-full border border-line px-4 text-xs font-semibold text-copy transition hover:border-line-strong hover:text-text"
        >
          Descargar informe en PDF
        </button>
        <button
          type="button"
          data-quiz-restart
          class="inline-flex h-9 items-center rounded-full border border-line px-4 text-xs font-semibold text-copy transition hover:border-line-strong hover:text-text"
        >
          Empezar de nuevo
        </button>
      </div>
    </div>

    <div>
      <p class="font-mono text-[11px] tracking-[0.22em] text-dim uppercase">Semáforo por capa</p>
      <ul class="mt-5 space-y-5">
        {
          quiz.layers.map((layer) => (
            <li class="qc-layer" data-layer-row={layer.id}>
              <div class="flex items-baseline justify-between gap-4">
                <p class="text-sm font-semibold text-text">{layer.name}</p>
                <p class="font-mono text-xs text-dim" data-layer-percent>
                  0%
                </p>
              </div>
              <div class="qc-layer-bar mt-2">
                <span data-layer-bar style="width:0%"></span>
              </div>
              <p class="mt-2 text-xs leading-relaxed text-dim">{layer.problems.join(' · ')}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-9 border-t border-line pt-6">
        <p class="font-mono text-[11px] tracking-[0.22em] text-brand-ink uppercase">
          Tus prioridades
        </p>
        <ul class="mt-4 space-y-3" data-recommendations></ul>
      </div>
    </div>
  </div>
</div>
