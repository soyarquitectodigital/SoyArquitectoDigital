---
import type { Tool } from '../../data/tools';

interface Props {
  tool: Tool;
  compact?: boolean;
  delay?: number;
  class?: string;
}

const { tool, compact = false, delay = 0, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  diagnostico: 'M10.5 4.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12ZM15.2 15.2 19.5 19.5',
  calculadora: 'M5 4.5h14v15H5zM8 8.5h8M8 12h2M12 12h2M16 12h.01M8 15.5h2M12 15.5h2M16 15.5h.01',
  checklist: 'M4.5 6.5l2 2 3-3M4.5 12.5l2 2 3-3M4.5 18.5l2 2 3-3M12 7.5h8M12 13.5h8M12 19.5h8',
  auditoria: 'M12 3v3M12 18v3M3 12h3M18 12h3M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
};
---

<li
  class:list={[
    'card hairline spotlight relative flex flex-col',
    compact ? 'p-5' : 'p-6 sm:p-7',
    className,
  ]}
  data-reveal
  data-glow
  style={`--delay:${delay}ms`}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <span
      class:list={[
        'grid place-items-center rounded-2xl border border-line bg-paper text-brand-ink',
        compact ? 'size-9' : 'size-11',
      ]}
    >
      <svg
        viewBox="0 0 24 24"
        class:list={[compact ? 'size-4' : 'size-5']}
        fill="none"
        aria-hidden="true"
      >
        <path
          d={icons[tool.icon]}
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span
      class:list={[
        'font-mono text-[11px] tracking-[0.2em] uppercase',
        tool.status === 'live' ? 'text-brand-ink' : 'text-dim',
      ]}
    >
      {tool.status === 'live' ? 'Disponible' : 'En preparación'}
    </span>
  </div>

  <h3
    class:list={[
      'font-heading font-semibold text-text',
      compact ? 'mt-4 text-sm' : 'mt-6 text-2xl leading-tight',
    ]}
  >
    {tool.name}
  </h3>
  <p
    class:list={[
      'text-copy',
      compact ? 'mt-1.5 text-xs leading-relaxed' : 'mt-3 flex-1 text-sm leading-relaxed',
    ]}
  >
    {tool.tagline}
  </p>

  {
    !compact && tool.bullets.length > 0 && (
      <ul class="mt-5 space-y-2">
        {tool.bullets.map((bullet) => (
          <li class="flex items-start gap-2.5 text-sm text-copy">
            <svg
              viewBox="0 0 24 24"
              class="mt-0.5 size-4 shrink-0 text-brand-ink"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m5 12.5 4.5 4.5L19 7.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {bullet}
          </li>
        ))}
      </ul>
    )
  }

  <p
    class:list={[
      'font-mono tracking-[0.18em] text-dim uppercase',
      compact ? 'mt-4 text-[10px]' : 'mt-5 text-[11px]',
    ]}
  >
    {tool.duration}
  </p>

  {
    !compact && (
      <div class="mt-6 border-t border-line pt-5">
        {tool.href ? (
          <a href={tool.href} class="qc-btn-primary">
            Abrir solución
            <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
              <path
                d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ) : (
          <p class="text-sm text-dim">
            La publico en las próximas semanas. Mientras tanto, si te urge, escríbeme.
          </p>
        )}
      </div>
    )
  }
</li>
