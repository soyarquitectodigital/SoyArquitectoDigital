---
interface Props {
  icon: string;
  class?: string;
}

const { icon, class: className = 'size-5' } = Astro.props;

// Iconos de línea, mismo lenguaje que el resto del sitio (stroke 1.5, remates redondos).
const icons: Record<string, string[]> = {
  link: [
    'M9.2 14.8 14.8 9.2',
    'M10.5 7.5l1.6-1.6a3.5 3.5 0 0 1 5 5l-1.6 1.6',
    'M13.5 16.5l-1.6 1.6a3.5 3.5 0 0 1-5-5l1.6-1.6',
  ],
  bolt: ['M13 3 5.5 13.5h5L11 21l7.5-10.5h-5L13 3Z'],
  window: [
    'M4 6.5h16v11H4z',
    'M4 9.5h16',
    'M8.5 13.2 7 14.8l1.5 1.6',
    'M15.5 13.2 17 14.8l-1.5 1.6',
  ],
  globe: [
    'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Z',
    'M3.5 12h17',
    'M12 3.5c-2.3 2.3-3.5 5.1-3.5 8.5s1.2 6.2 3.5 8.5c2.3-2.3 3.5-5.1 3.5-8.5S14.3 5.8 12 3.5Z',
  ],
  chart: ['M3.5 20h17', 'M7 20v-5.5', 'M11.5 20V9', 'M16 20v-8', 'M20.5 20V5'],
  cloud: ['M7 17.5h10a3.75 3.75 0 0 0 .4-7.5A5.5 5.5 0 0 0 6.6 9.6 4 4 0 0 0 7 17.5Z'],
  shield: ['M12 3.5 18.5 6v5.2c0 4.3-2.7 7.2-6.5 8.8-3.8-1.6-6.5-4.5-6.5-8.8V6L12 3.5Z', 'm9.2 11.6 2 2 3.6-3.6'],
};

const paths = icons[icon] ?? icons.link;
---

<svg viewBox="0 0 24 24" class={className} fill="none" aria-hidden="true">
  {paths.map((d) => (
    <path
      d={d}
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ))}
</svg>
