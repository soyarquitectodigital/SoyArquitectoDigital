---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  href: string;
  size?: 'md' | 'lg';
  class?: string;
  /** Ancho completo en móvil (por defecto). En escritorio se limita a max-w-md. */
  block?: boolean;
}

const { href, size = 'lg', class: className = '', block = true } = Astro.props;

const sizes = {
  md: 'min-h-12 py-3 text-[15px]',
  lg: 'min-h-14 py-3.5 text-base',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'group inline-flex items-center justify-center gap-3 rounded-full bg-wa px-6 text-center leading-snug font-body font-semibold text-white shadow-[0_14px_30px_-14px_rgba(11,122,62,0.75)] transition duration-300 hover:-translate-y-0.5 hover:bg-wa-strong hover:shadow-[0_18px_36px_-14px_rgba(11,122,62,0.85)]',
    block && 'w-full max-w-md',
    sizes[size],
    className,
  ]}
>
  <WhatsAppIcon class="size-5 shrink-0" />
  <span><slot /></span>
</a>
