---
import Wordmark from './Wordmark.astro';
import SocialLinks from './SocialLinks.astro';
import { bookingUrl, whatsappDefault } from '../config';
import { cases } from '../data/cases';

const diagnosisUrl = bookingUrl(
  'Hola Oswaldo, quiero agendar una llamada de diagnóstico para revisar mi ecosistema digital.',
);

// El orden del menú sigue el orden real de las secciones de la landing.
// Los casos de estudio solo aparecen cuando hay casos cargados.
const links = [
  { href: '/#problema', label: 'El problema' },
  { href: '/soluciones', label: 'Soluciones' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#enfoque', label: 'Enfoque' },
  { href: '/#trayectoria', label: 'Trayectoria' },
  ...(cases.length > 0 ? [{ href: '/#casos', label: 'Casos' }] : []),
  { href: '/#para-quien', label: 'Para quién', secondary: true },
  { href: '/#preguntas', label: 'Preguntas', secondary: true },
];

const currentPath = Astro.url.pathname;

const waIcon = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z';
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50" data-nav>
  <div class="container-page pt-3 sm:pt-4">
    <div
      class="nav-shell flex items-center justify-between gap-4 rounded-full border px-4 py-2.5 sm:px-5"
    >
      <a href="/" class="nav-logo shrink-0" aria-label="Soy Arquitecto Digital — ir al inicio">
        <Wordmark />
      </a>

      {/*
        En escritorio el menú ocupa el hueco central y se centra entre el logo y
        los botones. Los huecos crecen con el ancho, pero acotados: medido con
        Chrome, `justify-between` repartía el espacio y dejaba 74 px entre
        enlaces (se veían descolgados), mientras que con estos valores el texto
        queda a 40-48 px y nunca desborda ni a 1024 px.
      */}
      <nav
        class="hidden flex-1 items-center justify-center gap-3 lg:flex xl:gap-5"
        aria-label="Secciones"
      >
        {
          links.map((link) => (
            <a
              href={link.href}
              class:list={[
                'nav-link relative rounded-full px-3.5 py-2 text-sm font-medium whitespace-nowrap transition-colors',
                link.secondary && 'hidden 2xl:inline-flex',
                currentPath !== '/' && link.href.startsWith('/') && !link.href.includes('#') &&
                  currentPath.startsWith(link.href) &&
                  'is-active',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        <a
          href={diagnosisUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="nav-cta-ghost hidden h-10 items-center rounded-full border px-4 text-sm font-semibold whitespace-nowrap transition xl:inline-flex"
        >
          Agendar diagnóstico
        </a>
        <a
          href={whatsappDefault}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Hablemos por WhatsApp"
          class="inline-flex h-10 items-center gap-2 rounded-full bg-brand px-3 text-sm font-semibold text-on-brand transition hover:-translate-y-0.5 sm:px-4"
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d={waIcon}></path>
          </svg>
          <span class="hidden sm:inline">Hablemos</span>
        </a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="menu-movil"
          aria-label="Abrir menú"
          class="nav-burger inline-grid size-10 cursor-pointer place-items-center rounded-full border transition lg:hidden"
        >
          <svg viewBox="0 0 20 20" class="size-5" fill="none" aria-hidden="true">
            <path
              d="M3 6h14M3 10h14M3 14h14"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="menu-movil"
  class="on-dark fixed inset-0 z-[60] hidden bg-ink/98 backdrop-blur-xl lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <div class="container-page flex h-full flex-col pt-6 pb-10">
    <div class="flex items-center justify-between">
      <span class="text-white">
        <Wordmark />
      </span>
      <button
        type="button"
        data-menu-close
        aria-label="Cerrar menú"
        class="inline-grid size-10 cursor-pointer place-items-center rounded-full border border-line-dark text-white transition"
      >
        <svg viewBox="0 0 20 20" class="size-5" fill="none" aria-hidden="true">
          <path
            d="M5 5l10 10M15 5L5 15"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav class="mt-10 flex flex-col gap-1" aria-label="Secciones (móvil)">
      {
        links.map((link) => (
          <a
            href={link.href}
            data-menu-close
            class="font-heading border-b border-line-dark py-4 text-2xl text-white transition-colors hover:text-brand-light"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-auto space-y-3 pt-10">
      <a
        href={whatsappDefault}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-14 w-full items-center justify-center gap-2.5 rounded-full bg-brand text-base font-semibold text-on-brand"
      >
        <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true">
          <path d={waIcon}></path>
        </svg>
        Hablemos por WhatsApp
      </a>
      <p class="text-center text-sm text-dim-dark">
        Venezuela · Remoto — respuesta el mismo día
      </p>
      <div class="flex justify-center pt-2">
        <SocialLinks tone="dark" size="sm" />
      </div>
    </div>
  </div>
</div>
