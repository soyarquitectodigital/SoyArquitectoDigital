---
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import SocialLinks from './SocialLinks.astro';
import { site, socialHandle, bookingUrl, whatsappDefault } from '../config';

const diagnosisUrl = bookingUrl(
  'Hola Oswaldo, quiero agendar el diagnóstico gratuito para revisar mi ecosistema digital.',
);

const headline = [
  { text: '¿Tu' },
  { text: 'tecnología' },
  { text: 'impulsa' },
  { text: 'tu' },
  { text: 'negocio' },
  { text: 'o' },
  { text: 'frena', accent: true },
  { text: 'tu', accent: true },
  { text: 'crecimiento?', accent: true },
];
---

<section id="contacto" class="scroll-mt-24 bg-paper">
  <div class="gradient-close grain vignette animate-pan relative overflow-hidden">
    <div class="bg-grid-dark absolute inset-0 opacity-20" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -top-40 left-[-10%] size-[38rem] rounded-full bg-brand-light/12 blur-[150px]"
      aria-hidden="true"
    >
    </div>

    <div class="container-page relative py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <div class="flex justify-center">
          <Eyebrow number="07" tone="dark">Siguiente paso</Eyebrow>
        </div>

        <h2
          class="mt-6 font-heading display-lg font-semibold text-white"
          data-reveal
        >
          {
            headline.map((token, index) => (
              <>
                <span class="word-mask">
                  <span
                    class:list={['word-in', token.accent && 'text-gradient-light']}
                    style={`--d:${index * 80}ms`}
                  >
                    {token.text}
                  </span>
                </span>{' '}
              </>
            ))
          }
        </h2>
        <p class="mx-auto mt-6 max-w-2xl leading-relaxed text-copy-dark">
          Agendamos una llamada de diagnóstico sin coste. Salimos con una idea clara de por dónde
          empezar, contrates o no después. Si la auditoría encaja, en 5 días hábiles tienes
          informe, blueprint y roadmap de 90 días.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          <Button href={diagnosisUrl} size="lg" external>Agendar diagnóstico gratuito</Button>
          <Button href={whatsappDefault} variant="ghost-dark" size="lg" external>
            Prefiero escribir por WhatsApp
          </Button>
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-line-dark pt-8 text-sm text-copy-dark">
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 transition-colors hover:text-white"
          >
            <svg viewBox="0 0 20 20" class="size-4 text-brand-light" fill="none" aria-hidden="true">
              <path
                d="M3.5 5.5h13v9h-13zM3.5 6l6.5 5 6.5-5"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            {site.email}
          </a>
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden items-center gap-2 transition-colors hover:text-white sm:inline-flex"
          >
            <span class="font-mono text-xs tracking-[0.14em]">{socialHandle}</span>
          </a>
          <SocialLinks tone="dark" size="sm" />
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 20 20" class="size-4 text-brand-light" fill="none" aria-hidden="true">
              <path
                d="M10 17.5s5.5-4.7 5.5-8.6a5.5 5.5 0 1 0-11 0c0 3.9 5.5 8.6 5.5 8.6Z"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linejoin="round"></path>
              <circle cx="10" cy="8.8" r="1.9" stroke="currentColor" stroke-width="1.4"></circle>
            </svg>
            {site.location}
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
