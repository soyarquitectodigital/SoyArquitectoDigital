---
import { faqs } from '../data/faq';
import { whatsappDefault } from '../config';
---

<section id="preguntas" class="section-pad tint-brand scroll-mt-24 bg-paper">
  <div class="container-page">
    <div class="mx-auto max-w-4xl">
      <div class="space-y-3" data-reveal>
        {
          faqs.map((faq, index) => (
            <details
              class="card hairline group px-5 py-4 transition-colors open:border-line-strong hover:border-line-strong sm:px-6"
              data-reveal
              style={`--delay:${index * 70}ms`}
            >
              <summary class="flex cursor-pointer items-center justify-between gap-4 [&::-webkit-details-marker]:hidden">
                <span class="font-heading text-base leading-snug font-semibold text-text sm:text-lg">
                  {faq.question}
                </span>
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-paper text-base leading-none text-copy transition duration-300 group-open:rotate-45 group-open:bg-brand group-open:text-on-brand group-open:shadow-[0_0_0_4px_rgba(30,86,160,0.18)]">
                  +
                </span>
              </summary>
              <div class="faq-answer">
                <p class="mt-3 max-w-prose text-sm leading-relaxed text-copy sm:text-[15px]">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))
        }
      </div>

      <p class="mt-10 text-center text-sm text-copy" data-reveal>
        ¿La tuya no está aquí?{" "}
        <a
          href={whatsappDefault}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-brand-ink underline decoration-brand decoration-2 underline-offset-4 transition-colors hover:text-text"
        >
          Pregúntame por WhatsApp
        </a>{" "}
        y te contesto sin compromiso.
      </p>
    </div>
  </div>
</section>
