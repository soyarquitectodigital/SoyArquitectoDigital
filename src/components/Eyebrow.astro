---
interface Props {
  number: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { number, tone = 'light', class: className = '' } = Astro.props;
---

<p
  class:list={[
    'flex items-center gap-3 font-mono text-[11px] tracking-[0.24em] uppercase',
    tone === 'light' ? 'text-brand-ink' : 'text-brand-light',
    className,
  ]}
>
  <span>{number}</span>
  <span
    class:list={['h-px w-10', tone === 'light' ? 'bg-line-strong' : 'bg-white/25']}
    aria-hidden="true"></span>
  <span class:list={[tone === 'light' ? 'text-dim' : 'text-copy-dark']}><slot /></span>
</p>
