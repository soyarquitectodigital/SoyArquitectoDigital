---
import { stats, capabilities, environments, clientsAndTech } from '../data/stats';

const rowTech = [...capabilities, ...capabilities];
const rowProof = [...clientsAndTech, ...environments, ...clientsAndTech, ...environments];
---

<section class="border-b border-line bg-paper py-14 sm:py-16" aria-label="Autoridad y prueba social">
  <div class="container-page">
    <p
      class="mx-auto max-w-3xl text-center font-heading text-2xl leading-snug text-text sm:text-3xl"
      data-reveal
    >
      Más de 10 años conectando <span class="text-brand-ink">software</span>,{' '}
      <span class="text-brand-ink">infraestructura física</span> y{' '}
      <span class="text-brand-ink">estrategia digital</span>.
    </p>

    {/* Las cifras que antes vivían en el hero: aquí respiran y no compiten con el titular. */}
    <div class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        stats.map((stat, index) => (
          <div class="border-t border-line pt-6" data-reveal style={`--delay:${index * 90}ms`}>
            {stat.count ? (
              <p
                class="font-heading text-gradient-ink text-4xl leading-none font-semibold sm:text-5xl"
                data-count={stat.count}
                data-prefix={stat.prefix ?? ''}
                data-suffix={stat.suffix ?? ''}
              >
                {`${stat.prefix ?? ''}${stat.count}${stat.suffix ?? ''}`}
              </p>
            ) : (
              <p class="font-heading text-gradient-ink text-4xl leading-none font-semibold sm:text-5xl">
                {stat.value}
              </p>
            )}
            <p class="mt-3 text-sm leading-relaxed text-copy">{stat.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-12 space-y-3 sm:mt-14">
      <div class="marquee-mask overflow-hidden">
        <div class="marquee-track">
          {
            rowTech.map((item) => (
              <span class="chip mr-3 shrink-0 px-4 py-2 text-sm whitespace-nowrap">
                <span class="size-1.5 rounded-full bg-brand-2" aria-hidden="true" />
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <div class="marquee-mask overflow-hidden">
        <div class="marquee-track marquee-reverse">
          {
            rowProof.map((item) => (
              <span class="mr-3 inline-flex shrink-0 items-center gap-2 rounded-full border border-line bg-ink px-4 py-2 text-sm font-medium whitespace-nowrap text-white">
                <span class="size-1.5 rounded-full bg-brand-light" aria-hidden="true" />
                {item}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <p class="mt-8 text-center font-mono text-[11px] tracking-[0.2em] text-dim uppercase">
      Tecnología · Entornos · Equipos con los que he trabajado
    </p>
  </div>
</section>
