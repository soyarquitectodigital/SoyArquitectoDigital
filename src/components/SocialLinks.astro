const sizes = {
  sm: 'size-9',
  md: 'size-11',
};

const tones = {
  dark: 'border-line-dark bg-white/6 text-copy-dark hover:border-brand-light/50 hover:bg-brand-light/12 hover:text-white',
  light:
    'border-line bg-surface text-copy shadow-card hover:border-brand/40 hover:bg-brand/8 hover:text-brand-ink',
};
---

<ul class:list={['flex flex-wrap items-center gap-2.5', className]}>
  {
    socials.map((social) => (
      <li>
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${social.label} de Soy Arquitecto Digital (${social.handle})`}
          title={`${social.label} · ${social.handle}`}
          class:list={[
            'grid place-items-center rounded-full border transition duration-300 hover:-translate-y-0.5',
            sizes[size],
            tones[tone],
          ]}
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d={icons[social.icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>
