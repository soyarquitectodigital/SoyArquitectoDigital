---
import Eyebrow from './Eyebrow.astro';
import { liveTools, upcomingTools } from '../data/tools';

const icons: Record<string, string> = {
  diagnostico: 'M10.5 4.5a6 6 0 1 0 0 12 6 6 0 0 0 0-12ZM15.2 15.2 19.5 19.5',
  calculadora: 'M5 4.5h14v15H5zM8 8.5h8M8 12h2M12 12h2M16 12h.01M8 15.5h2M12 15.5h2M16 15.5h.01',
  checklist: 'M4.5 6.5l2 2 3-3M4.5 12.5l2 2 3-3M4.5 18.5l2 2 3-3M12 7.5h8M12 13.5h8M12 19.5h8',
  auditoria: 'M12 3v3M12 18v3M3 12h3M18 12h3M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
};

const live = liveTools[0];
---

<section id="herramientas" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
  <div class="container-page">
    <Eyebrow number="02">Herramientas</Eyebrow>

    <div class="mt-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div data-reveal>
        <h2 class="font-heading display-lg font-semibold text-text">
          Decide con <span class="text-gradient-brand">datos</span>, no con intuición
        </h2>
        <p class="mt-5 max-w-md leading-relaxed text-copy">
          Herramientas gratuitas que uso en mis propios diagnósticos, abiertas para que puedas
          evaluar tu ecosistema antes de invertir un euro. Sin registro y sin humo: el resultado se
          calcula en tu navegador.
        </p>

        <p class="mt-6 text-sm leading-relaxed text-dim">
          Voy publicando una nueva cada mes. Si quieres sugerir alguna, escríbeme.
        </p>
      </div>

      <div class="grid gap-4">
        {
          live && (
            <article
              class="card hairline spotlight relative p-6 sm:p-8"
              data-reveal
              data-glow
            >
              <div class="flex flex-wrap items-center justify-between gap-3">
                <span class="inline-flex items-center gap-3">
                  <span class="grid size-11 place-items-center rounded-2xl border border-line bg-paper text-brand-ink">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true">
                      <path
                        d={icons[live.icon]}
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span class="pill border-line bg-paper text-copy">{live.duration}</span>
                </span>
                <span class="font-mono text-[11px] tracking-[0.2em] text-brand-ink uppercase">
                  Disponible
                </span>
              </div>

              <h3 class="font-heading mt-6 text-2xl font-semibold text-text">{live.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-copy">{live.tagline}</p>

              <ul class="mt-5 space-y-2">
                {live.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm text-copy">
                    <svg viewBox="0 0 24 24" class="mt-0.5 size-4 shrink-0 text-brand-ink" fill="none" aria-hidden="true">
                      <path
                        d="m5 12.5 4.5 4.5L19 7.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {bullet}
                  </li>
                ))}
              </ul>

              <div class="mt-7 flex flex-wrap items-center gap-3">
                <a href={live.href} class="qc-btn-primary">
                  Hacer el diagnóstico
                  <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
                    <path
                      d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
                <a
                  href="/herramientas"
                  class="text-sm font-semibold text-brand-ink underline decoration-brand decoration-2 underline-offset-4 transition-colors hover:text-text"
                >
                  Ver todas las herramientas
                </a>
              </div>
            </article>
          )
        }

        <ul class="grid gap-3 sm:grid-cols-3">
          {
            upcomingTools.map((tool) => (
              <li class="rounded-card border border-line bg-paper p-5" data-reveal>
                <span class="grid size-9 place-items-center rounded-xl border border-line bg-surface text-dim">
                  <svg viewBox="0 0 24 24" class="size-4" fill="none" aria-hidden="true">
                    <path
                      d={icons[tool.icon]}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <p class="mt-4 text-sm font-semibold text-text">{tool.name}</p>
                <p class="mt-1.5 text-xs leading-relaxed text-copy">{tool.tagline}</p>
                <p class="mt-4 font-mono text-[10px] tracking-[0.18em] text-dim uppercase">
                  En preparación
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
