---
import Eyebrow from './Eyebrow.astro';
import ToolCard from './tools/ToolCard.astro';
import { liveTools, upcomingTools } from '../data/tools';

const featured = liveTools[0];
const soon = upcomingTools;
---

<section id="soluciones" class="section-pad tint-brand scroll-mt-24 border-y border-line bg-surface">
  <div class="container-page">
    <Eyebrow number="02">Soluciones</Eyebrow>

    <div class="mt-8 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
      <div data-reveal>
        <h2 class="font-heading display-lg font-semibold text-text">
          Entra en Soluciones y <span class="text-gradient-brand">mide tu ecosistema</span>
        </h2>
        <p class="mt-5 max-w-md leading-relaxed text-copy">
          Estoy construyendo herramientas propias para diagnosticar y ordenar ecosistemas digitales.
          Son las mismas que uso en mis auditorías, abiertas para que puedas medir tu situación antes
          de invertir un euro.
        </p>

        <ul class="mt-7 space-y-3 text-sm text-copy">
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-ink" aria-hidden="true"></span>
            Sin registro, sin coste y calculadas en tu navegador.
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-ink" aria-hidden="true"></span>
            Resultado inmediato con prioridades concretas.
          </li>
          <li class="flex items-start gap-2.5">
            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-ink" aria-hidden="true"></span>
            Publico una nueva cada mes: {liveTools.length} disponible{liveTools.length === 1
              ? ''
              : 's'} y {soon.length} en preparación.
          </li>
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/soluciones" class="qc-btn-primary">
            Ver todas las soluciones
            <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
              <path
                d="M4.2 10h11.6M10 4.2 15.8 10 10 15.8"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          {
            featured?.href && (
              <a
                href={featured.href}
                class="text-sm font-semibold text-brand-ink underline decoration-brand decoration-2 underline-offset-4 transition-colors hover:text-text"
              >
                Ir al diagnóstico (3 min)
              </a>
            )
          }
        </div>
      </div>

      <ul class="grid gap-4">
        {featured && <ToolCard tool={featured} variant="wide" />}
        {soon.map((tool, index) => <ToolCard tool={tool} variant="row" delay={(index + 1) * 70} />)}
      </ul>
    </div>
  </div>
</section>
